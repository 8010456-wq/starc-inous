// ============================================================================
//  SUT1 :: inuos/net6.staro —— IPv6 / 双栈网络能力（自研，零第三方）
//  只依赖 ws2_32 / kernel32 / msvcrt
//
//  设计要点（2026-11-03 实测确认）：
//   · AF_INET6 = 23，sockaddr_in6 = 28 字节
//     布局：family(2B) port(2B 网络序) flowinfo(4B) addr(16B) scope_id(4B)
//   · IPV6_V6ONLY 默认 1（Vista+）→ 显式 setsockopt(level=41, opt=27, 0) 才能双栈
//   · 实测：双栈 socket 绑 [::]:PORT 后，netstat 同时出现 0.0.0.0 与 [::]，
//            IPv4 与 IPv6 均可连入（一个 socket 吃两种网）
//   · 地址解析用 ws2_32!inet_pton（实测返回 1，16 字节正确）。注意 InetPtonA 在部分
//     环境未导出，inet_pton 更稳。
// ============================================================================

linx "ws2_32.dll!socket"
linx "ws2_32.dll!bind"
linx "ws2_32.dll!listen"
linx "ws2_32.dll!connect"
linx "ws2_32.dll!closesocket"
linx "ws2_32.dll!setsockopt"
linx "ws2_32.dll!inet_pton"
linx "kernel32.dll!GetProcessHeap"
linx "kernel32.dll!HeapAlloc"
linx "kernel32.dll!HeapFree"
linx "msvcrt.dll!memset"
linx "msvcrt.dll!memcpy"
linx "msvcrt.dll!strlen"

// ---------------- 地址解析 ----------------

// 文本 IPv6（如 "2409:8a3c:3d37:69e1::"）→ out16 的 16 字节
// 返回 1 成功 / 0 失败
Funktion sut_pton6(text, out16)
    memset(out16, 0, 16)
    r = inet_pton(23, cstr(text), out16)
    Wenn r != 1 dann
        gebe_zurueck 0
    Ende
    gebe_zurueck 1
Ende

// 判断文本地址是否 IPv6（含冒号即认为是 IPv6）
Funktion sut_is_v6(text)
    n = strlen(cstr(text))
    i = 0
    Solange i < n
        Wenn byteat(text, i) == 58 dann
            gebe_zurueck 1
        Ende
        i = i + 1
    Ende
    gebe_zurueck 0
Ende

// ---------------- 监听 ----------------

// 双栈监听：一个 socket 同时接受 IPv4 + IPv6。
// IPv6 不可用时自动回退到 IPv4 监听（sut_listen 在 net.staro 里）。
// 返回 srv（>=0）；失败返回负值
Funktion sut_listen_dual(port)
    h = GetProcessHeap()
    s = socket(23, 1, 6)
    Wenn s < 0 dann
        gebe_zurueck sut_listen(port)
    Ende

    // IPV6_V6ONLY = 0 → 双栈
    v = HeapAlloc(h, 0, 8)
    memset(v, 0, 8)
    o = setsockopt(s, 41, 27, v, 4)
    HeapFree(h, 0, v)
    Wenn o != 0 dann
        closesocket(s)
        gebe_zurueck sut_listen(port)
    Ende

    addr = HeapAlloc(h, 0, 32)
    memset(addr, 0, 32)
    memset(addr, 23, 1)                 // family = AF_INET6
    hi = port / 256
    lo = port - hi * 256
    memset(addr + 2, hi, 1)             // port 网络序
    memset(addr + 3, lo, 1)
    // addr+8..23 全 0 = "::"
    b = bind(s, addr, 28)
    HeapFree(h, 0, addr)
    Wenn b != 0 dann
        closesocket(s)
        gebe_zurueck sut_listen(port)
    Ende

    l = listen(s, 32)
    Wenn l != 0 dann
        closesocket(s)
        gebe_zurueck 0 - 3
    Ende
    gebe_zurueck s
Ende

// ---------------- 连接 ----------------

// 连 IPv6：addr16 为 16 字节地址（inet_pton 解析结果）
// 返回 socket（>=0）；失败返回负值
Funktion sut_connect6(addr16, port)
    h = GetProcessHeap()
    addr = HeapAlloc(h, 0, 32)
    memset(addr, 0, 32)
    memset(addr, 23, 1)
    hi = port / 256
    lo = port - hi * 256
    memset(addr + 2, hi, 1)
    memset(addr + 3, lo, 1)
    memcpy(addr + 8, addr16, 16)
    s = socket(23, 1, 6)
    Wenn s < 0 dann
        HeapFree(h, 0, addr)
        gebe_zurueck 0 - 2
    Ende
    r = connect(s, addr, 28)
    HeapFree(h, 0, addr)
    Wenn r != 0 dann
        closesocket(s)
        gebe_zurueck 0 - 3
    Ende
    gebe_zurueck s
Ende

// 按文本地址自动选协议连接（含冒号走 IPv6，否则 IPv4）
Funktion sut_connect_auto(text, port)
    Wenn sut_is_v6(text) == 1 dann
        a16 = HeapAlloc(GetProcessHeap(), 0, 16)
        memset(a16, 0, 16)
        ok = sut_pton6(text, a16)
        Wenn ok != 1 dann
            HeapFree(GetProcessHeap(), 0, a16)
            gebe_zurueck 0 - 4
        Ende
        s = sut_connect6(a16, port)
        HeapFree(GetProcessHeap(), 0, a16)
        gebe_zurueck s
    Ende
    gebe_zurueck sut_connect(text, port)
Ende
