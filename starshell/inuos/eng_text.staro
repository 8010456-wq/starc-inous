// ============================================================================
//  starshell :: inuos/eng_text.staro
//  Selbst implementierte Text-Befehle (keine Weiterleitung, reine Berechnung)
//  args = C-String des Befehlsrests (nach dem Befehlsnamen).
// ============================================================================

Funktion eng_text(op, args)
    Wenn str_eq(op, "laenge") dann
        s = extract_arg(args, 0)
        write_int(str_len(s))
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "gross") dann
        s = c_rest(args, 0)
        write_str(str_upper(s))
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "klein") dann
        s = c_rest(args, 0)
        write_str(str_lower(s))
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "umgekehrt") dann
        s = c_rest(args, 0)
        write_str(str_reverse(s))
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "trim") dann
        s = c_rest(args, 0)
        write_str(str_trim(s))
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "teil") dann
        s = extract_arg(args, 0)
        von = str_to_int(argument_n(args, 0, 2))
        bis = str_to_int(argument_n(args, 0, 3))
        n = str_len(s)
        Wenn von < 0 dann
            von = 0
        Ende
        Wenn bis > n dann
            bis = n
        Ende
        Wenn bis <= von dann
            write_newline()
            gebe_zurueck 1
        Ende
        write_str(str_slice(s, von, bis - von))
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "zeichen") dann
        s = extract_arg(args, 0)
        pos = str_to_int(argument_n(args, 0, 2))
        n = str_len(s)
        Wenn pos < 0 dann
            pos = 0
        Ende
        Wenn pos >= n dann
            write_newline()
            gebe_zurueck 1
        Ende
        ch = alloc(2)
        raw_setbyte(ch, 8, raw_byteat(s, 8 + pos))
        raw_setbyte(ch, 9, 0)
        raw_setbyte(ch, 0, 1)
        write_str(ch)
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "wort") dann
        s = c_rest(args, 0)
        nr = str_to_int(argument_n(args, 0, 1))
        Wenn nr < 1 dann
            nr = 1
        Ende
        w = argument_n(s, 0, nr)
        write_str(w)
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "wortzahl") dann
        s = c_rest(args, 0)
        zaehler = 0
        i = 0
        inwort = 0
        n = str_len(s)
        Solange i < n
            ch = raw_byteat(s, 8 + i)
            Wenn ch == 32 dann
                Wenn inwort == 1 dann
                    zaehler = zaehler + 1
                    inwort = 0
                Ende
            Sonst
                inwort = 1
            Ende
            i = i + 1
        Ende
        Wenn inwort == 1 dann
            zaehler = zaehler + 1
        Ende
        write_int(zaehler)
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "suche") dann
        s = extract_arg(args, 0)
        m = extract_arg(args, str_len(s) + 1)
        n = str_len(s)
        ml = str_len(m)
        Wenn ml == 0 dann
            write_str("nicht gefunden")
            write_newline()
            gebe_zurueck 1
        Ende
        gefunden = 0
        i = 0
        Solange i + ml <= n
            ok = 1
            j = 0
            Solange j < ml
                Wenn raw_byteat(s, 8 + i + j) != raw_byteat(m, 8 + j) dann
                    ok = 0
                Ende
                j = j + 1
            Ende
            Wenn ok == 1 dann
                write_int(i)
                write_newline()
                gefunden = 1
                gebe_zurueck 1
            Ende
            i = i + 1
        Ende
        Wenn gefunden == 0 dann
            write_str("nicht gefunden")
            write_newline()
        Ende
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "ersetze") dann
        s = extract_arg(args, 0)
        alt = extract_arg(args, str_len(s) + 1)
        neu = extract_arg(args, str_len(s) + str_len(alt) + 2)
        n = str_len(s)
        al = str_len(alt)
        Wenn al == 0 dann
            write_str(s)
            write_newline()
            gebe_zurueck 1
        Ende
        buf = alloc(8 + n * 2 + 2)
        pos = 0
        i = 0
        Solange i < n
            ok = 1
            j = 0
            Solange j < al
                Wenn i + j >= n dann
                    ok = 0
                Sonst
                    Wenn raw_byteat(s, 8 + i + j) != raw_byteat(alt, 8 + j) dann
                        ok = 0
                    Ende
                Ende
                j = j + 1
            Ende
            Wenn ok == 1 dann
                k = 0
                Solange k < str_len(neu)
                    raw_setbyte(buf, 8 + pos, raw_byteat(neu, 8 + k))
                    pos = pos + 1
                    k = k + 1
                Ende
                i = i + al
            Sonst
                raw_setbyte(buf, 8 + pos, raw_byteat(s, 8 + i))
                pos = pos + 1
                i = i + 1
            Ende
        Ende
        raw_setbyte(buf, 0, pos % 256)
        raw_setbyte(buf, 1, (pos / 256) % 256)
        raw_setbyte(buf, 2, (pos / 65536) % 256)
        raw_setbyte(buf, 3, (pos / 16777216) % 256)
        raw_setbyte(buf, 8 + pos, 0)
        write_str(buf)
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "enthaelt") dann
        s = extract_arg(args, 0)
        m = extract_arg(args, str_len(s) + 1)
        n = str_len(s)
        ml = str_len(m)
        gefunden = 0
        Wenn ml != 0 dann
            i = 0
            Solange i + ml <= n
                ok = 1
                j = 0
                Solange j < ml
                    Wenn raw_byteat(s, 8 + i + j) != raw_byteat(m, 8 + j) dann
                        ok = 0
                    Ende
                    j = j + 1
                Ende
                Wenn ok == 1 dann
                    gefunden = 1
                    i = n
                Ende
                i = i + 1
            Ende
        Ende
        Wenn gefunden == 1 dann
            write_str("ja")
        Sonst
            write_str("nein")
        Ende
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "beginnt") dann
        s = extract_arg(args, 0)
        m = extract_arg(args, str_len(s) + 1)
        Wenn str_starts_with(s, m) == 1 dann
            write_str("ja")
        Sonst
            write_str("nein")
        Ende
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "vergleiche") dann
        s = extract_arg(args, 0)
        m = extract_arg(args, str_len(s) + 1)
        Wenn str_eq(s, m) == 1 dann
            write_str("gleich")
        Sonst
            write_str("ungleich")
        Ende
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "zeichenzahl") dann
        s = c_rest(args, 0)
        write_int(str_len(s))
        write_newline()
        gebe_zurueck 1
    Ende
    Wenn str_eq(op, "leer") dann
        s = c_rest(args, 0)
        Wenn str_len(s) == 0 dann
            write_str("ja")
        Sonst
            write_str("nein")
        Ende
        write_newline()
        gebe_zurueck 1
    Ende
    gebe_zurueck 0
Ende
