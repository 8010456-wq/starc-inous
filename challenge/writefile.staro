// writefile.staro - 文件写入能力（逻辑文件，允许 linx）
// 参考 starcx64/inuos/file.staro 的实现，自包含（含 raw_set32）
linx "kernel32.dll!CreateFileA"
linx "kernel32.dll!WriteFile"
linx "kernel32.dll!CloseHandle"

// 小端 32 位写（written 指针用）
Funktion wf_set32(ptr, off, val)
    raw_setbyte(ptr, off, val % 256)
    raw_setbyte(ptr, off + 1, (val / 256) % 256)
    raw_setbyte(ptr, off + 2, (val / 65536) % 256)
    raw_setbyte(ptr, off + 3, (val / 16777216) % 256)
    gebe_zurueck 0
Ende

// 写 buf[0..len) 到文件 path（StarC 字符串），返回 1 成功 0 失败
// CreateFileA(path, GENERIC_WRITE=0x40000000, 0, 0, CREATE_ALWAYS=2, FILE_ATTRIBUTE_NORMAL=0x80, 0)
Funktion file_write(path, buf, len)
    h = CreateFileA(cstr(path), 1073741824, 0, 0, 2, 128, 0)
    Wenn h == -1 dann
        gebe_zurueck 0
    Ende
    written = alloc(4)
    wf_set32(written, 0, 0)
    r = WriteFile(h, buf, len, written, 0)
    CloseHandle(h)
    Wenn r == 0 dann
        gebe_zurueck 0
    Ende
    gebe_zurueck 1
Ende
