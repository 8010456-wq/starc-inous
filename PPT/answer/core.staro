// ============================================================================
//  starshell :: inuos/core.staro
//  StarShell V4 能力库 · 核心：控制台输出 + 字符串操作 + 命令行解析
//  铁律 E：能力全部在此 .staro 实现。只用语言原语 alloc/raw_setbyte/
//  raw_byteat + WinAPI(linx-o)。禁用 Ausgeben/i2s/byteat/as_str 等内建。
//  本库由 starcc 编译时自动扫描（当前目录 inuos/ 下全部 .staro 自动并入）。
// ============================================================================

linx-o kernel32 GetStdHandle WriteFile GetCommandLineA GetTickCount
linx-o kernel32 GetCurrentProcessId GetConsoleMode SetConsoleMode ReadConsoleA ReadFile

// ---------- 控制台句柄 ----------

Funktion get_stdout()
    gebe_zurueck GetStdHandle(-11)
Ende

// ---------- StarC 字符串基本（8 字节头 + 数据 + NUL）----------

Funktion str_len(str)
    i = 0
    Solange raw_byteat(str, 8 + i) != 0
        i = i + 1
    Ende
    gebe_zurueck i
Ende

Funktion str_at(str, pos)
    gebe_zurueck raw_byteat(str, 8 + pos)
Ende

// 复制 StarC 字符串（返回新分配）
Funktion str_copy(str)
    n = str_len(str)
    buf = alloc(8 + n + 1)
    i = 0
    Solange i < n
        raw_setbyte(buf, 8 + i, raw_byteat(str, 8 + i))
        i = i + 1
    Ende
    raw_setbyte(buf, 0, n % 256)
    raw_setbyte(buf, 1, (n / 256) % 256)
    raw_setbyte(buf, 2, (n / 65536) % 256)
    raw_setbyte(buf, 3, (n / 16777216) % 256)
    raw_setbyte(buf, 8 + n, 0)
    gebe_zurueck buf
Ende

// 拼接两 StarC 字符串
Funktion str_concat(s1, s2)
    n1 = str_len(s1)
    n2 = str_len(s2)
    buf = alloc(8 + n1 + n2 + 1)
    i = 0
    Solange i < n1
        raw_setbyte(buf, 8 + i, raw_byteat(s1, 8 + i))
        i = i + 1
    Ende
    i = 0
    Solange i < n2
        raw_setbyte(buf, 8 + n1 + i, raw_byteat(s2, 8 + i))
        i = i + 1
    Ende
    raw_setbyte(buf, 0, (n1 + n2) % 256)
    raw_setbyte(buf, 1, ((n1 + n2) / 256) % 256)
    raw_setbyte(buf, 2, ((n1 + n2) / 65536) % 256)
    raw_setbyte(buf, 3, ((n1 + n2) / 16777216) % 256)
    raw_setbyte(buf, 8 + n1 + n2, 0)
    gebe_zurueck buf
Ende

// 从 C 字符串（0 结尾）生成 StarC 字符串
Funktion cstr_to_starc(c)
    n = 0
    Solange raw_byteat(c, n) != 0
        n = n + 1
    Ende
    buf = alloc(8 + n + 1)
    raw_setbyte(buf, 0, n % 256)
    raw_setbyte(buf, 1, (n / 256) % 256)
    raw_setbyte(buf, 2, (n / 65536) % 256)
    raw_setbyte(buf, 3, (n / 16777216) % 256)
    i = 0
    Solange i < n
        raw_setbyte(buf, 8 + i, raw_byteat(c, i))
        i = i + 1
    Ende
    raw_setbyte(buf, 8 + n, 0)
    gebe_zurueck buf
Ende

// StarC 字符串 -> C 字符串（返回裸指针，仅临时用）
Funktion starc_to_cstr(s)
    n = str_len(s)
    buf = alloc(n + 1)
    i = 0
    Solange i < n
        raw_setbyte(buf, i, raw_byteat(s, 8 + i))
        i = i + 1
    Ende
    raw_setbyte(buf, n, 0)
    gebe_zurueck buf
Ende

// ---------- 控制台输出（WriteFile，不用 Ausgeben）----------

Funktion write_cstr(c)
    n = 0
    Solange raw_byteat(c, n) != 0
        n = n + 1
    Ende
    WriteFile(get_stdout(), c, n, 0, 0)
    gebe_zurueck 0
Ende

Funktion write_str(str)
    WriteFile(get_stdout(), str + 8, str_len(str), 0, 0)
    gebe_zurueck 0
Ende

Funktion write_newline()
    nl = alloc(1)
    raw_setbyte(nl, 0, 10)
    WriteFile(get_stdout(), nl, 1, 0, 0)
    gebe_zurueck 0
Ende

// ---------- 整数 -> StarC 字符串 ----------

Funktion int_to_str(num)
    Wenn num == 0 dann
        buf = alloc(10)
        raw_setbyte(buf, 0, 1)
        raw_setbyte(buf, 1, 0)
        raw_setbyte(buf, 2, 0)
        raw_setbyte(buf, 3, 0)
        raw_setbyte(buf, 8, 48)
        raw_setbyte(buf, 9, 0)
        gebe_zurueck buf
    Ende
    neg = 0
    Wenn num < 0 dann
        neg = 1
        num = 0 - num
    Ende
    digits = alloc(24)
    di = 0
    Solange num > 0
        raw_setbyte(digits, di, num % 10)
        di = di + 1
        num = num / 10
    Ende
    buf = alloc(24)
    pos = 0
    Wenn neg == 1 dann
        raw_setbyte(buf, 8 + pos, 45)
        pos = pos + 1
    Ende
    i = di - 1
    Solange i >= 0
        raw_setbyte(buf, 8 + pos, raw_byteat(digits, i) + 48)
        pos = pos + 1
        i = i - 1
    Ende
    raw_setbyte(buf, 0, pos % 256)
    raw_setbyte(buf, 1, (pos / 256) % 256)
    raw_setbyte(buf, 2, (pos / 65536) % 256)
    raw_setbyte(buf, 3, (pos / 16777216) % 256)
    raw_setbyte(buf, 8 + pos, 0)
    gebe_zurueck buf
Ende

Funktion write_int(num)
    write_str(int_to_str(num))
    gebe_zurueck 0
Ende

// ---------- 字符串比较 ----------

Funktion str_eq(s1, s2)
    n1 = str_len(s1)
    n2 = str_len(s2)
    Wenn n1 != n2 dann
        gebe_zurueck 0
    Ende
    i = 0
    Solange i < n1
        Wenn raw_byteat(s1, 8 + i) != raw_byteat(s2, 8 + i) dann
            gebe_zurueck 0
        Ende
        i = i + 1
    Ende
    gebe_zurueck 1
Ende

// 大小写不敏感字符串比较（ASCII）
Funktion str_eq_ci(s1, s2)
    n1 = str_len(s1)
    n2 = str_len(s2)
    Wenn n1 != n2 dann
        gebe_zurueck 0
    Ende
    i = 0
    Solange i < n1
        c1 = raw_byteat(s1, 8 + i)
        c2 = raw_byteat(s2, 8 + i)
        Wenn c1 >= 65 dann
            Wenn c1 <= 90 dann
                c1 = c1 + 32
            Ende
        Ende
        Wenn c2 >= 65 dann
            Wenn c2 <= 90 dann
                c2 = c2 + 32
            Ende
        Ende
        Wenn c1 != c2 dann
            gebe_zurueck 0
        Ende
        i = i + 1
    Ende
    gebe_zurueck 1
Ende

// C 字符串从 pos 起是否等于 StarC 字符串（边界为空格/NUL）
Funktion str_eq_at(c, pos, s)
    n = str_len(s)
    i = 0
    Solange i < n
        Wenn raw_byteat(c, pos + i) != raw_byteat(s, 8 + i) dann
            gebe_zurueck 0
        Ende
        i = i + 1
    Ende
    nb = raw_byteat(c, pos + n)
    Wenn nb != 32 dann
        Wenn nb != 0 dann
            gebe_zurueck 0
        Ende
    Ende
    gebe_zurueck 1
Ende

// ---------- 命令行 ----------

Funktion get_cmdline_cstr()
    gebe_zurueck GetCommandLineA()
Ende

// 从 C 字符串 start 起取下一个参数（StarC 字符串）
Funktion extract_arg(c, start)
    Solange raw_byteat(c, start) == 32
        start = start + 1
    Ende
    e = start
    f = 0
    ch = raw_byteat(c, e)
    Solange f == 0
        Wenn ch == 32 dann
            f = 1
        Sonst
            Wenn ch == 0 dann
                f = 1
            Sonst
                e = e + 1
                ch = raw_byteat(c, e)
            Ende
        Ende
    Ende
    n = e - start
    buf = alloc(8 + n + 1)
    raw_setbyte(buf, 0, n % 256)
    raw_setbyte(buf, 1, (n / 256) % 256)
    raw_setbyte(buf, 2, (n / 65536) % 256)
    raw_setbyte(buf, 3, (n / 16777216) % 256)
    i = 0
    Solange i < n
        raw_setbyte(buf, 8 + i, raw_byteat(c, start + i))
        i = i + 1
    Ende
    raw_setbyte(buf, 8 + n, 0)
    gebe_zurueck buf
Ende

// 数字 -> 是否数字字符
Funktion is_digit(ch)
    Wenn ch >= 48 dann
        Wenn ch <= 57 dann
            gebe_zurueck 1
        Ende
    Ende
    gebe_zurueck 0
Ende

// StarC 字符串 -> 整数
Funktion str_to_int(s)
    n = str_len(s)
    i = 0
    v = 0
    neg = 0
    Wenn n > 0 dann
        Wenn raw_byteat(s, 8) == 45 dann
            neg = 1
            i = 1
        Ende
    Ende
    Solange i < n
        ch = raw_byteat(s, 8 + i)
        Wenn is_digit(ch) == 1 dann
            v = v * 10 + (ch - 48)
        Ende
        i = i + 1
    Ende
    Wenn neg == 1 dann
        v = 0 - v
    Ende
    gebe_zurueck v
Ende

// ---------- 控制台输入（ReadFile 逐字节）----------

// 读一行（去掉行尾 CR LF），返回 StarC 字符串；EOF 返回 0
Funktion read_line()
    h = GetStdHandle(-10)
    buf = alloc(1024)
    i = 0
    fertig = 0
    Solange fertig == 0
        nb = alloc(4)
        ok = ReadFile(h, buf + i, 1, nb, 0)
        n = raw_byteat(nb, 0) + raw_byteat(nb, 1) * 256 + raw_byteat(nb, 2) * 65536 + raw_byteat(nb, 3) * 16777216
        Wenn ok == 0 dann
            fertig = 1
        Sonst
            Wenn n == 0 dann
                fertig = 1
            Sonst
                ch = raw_byteat(buf, i)
                Wenn ch == 10 dann
                    fertig = 1
                Sonst
                    Wenn ch == 13 dann
                        // CR 忽略
                    Sonst
                        i = i + 1
                    Ende
                Ende
            Ende
        Ende
    Ende
    Wenn i == 0 dann
        gebe_zurueck 0
    Ende
    s = alloc(8 + i + 1)
    raw_setbyte(s, 0, i % 256)
    raw_setbyte(s, 1, (i / 256) % 256)
    raw_setbyte(s, 2, (i / 65536) % 256)
    raw_setbyte(s, 3, (i / 16777216) % 256)
    j = 0
    Solange j < i
        raw_setbyte(s, 8 + j, raw_byteat(buf, j))
        j = j + 1
    Ende
    raw_setbyte(s, 8 + i, 0)
    gebe_zurueck s
Ende

// C 字符串追加：把 s（StarC 字符串）的数据追加到 buf（C 字符串缓冲区）的
// off 处，返回新的写入位置。不自动补 NUL（调用方最后补）。
Funktion cstr_append(buf, off, s)
    n = str_len(s)
    i = 0
    Solange i < n
        raw_setbyte(buf, off, raw_byteat(s, 8 + i))
        off = off + 1
        i = i + 1
    Ende
    gebe_zurueck off
Ende

// Teilstring: ab Position start, len Zeichen, als neue StarC-Zeichenkette
Funktion str_slice(s, start, len)
    buf = alloc(8 + len + 1)
    raw_setbyte(buf, 0, len % 256)
    raw_setbyte(buf, 1, (len / 256) % 256)
    raw_setbyte(buf, 2, (len / 65536) % 256)
    raw_setbyte(buf, 3, (len / 16777216) % 256)
    i = 0
    Solange i < len
        raw_setbyte(buf, 8 + i, raw_byteat(s, 8 + start + i))
        i = i + 1
    Ende
    raw_setbyte(buf, 8 + len, 0)
    gebe_zurueck buf
Ende

// ASCII-Grossbuchstaben
Funktion str_upper(s)
    n = str_len(s)
    buf = alloc(8 + n + 1)
    i = 0
    Solange i < n
        ch = raw_byteat(s, 8 + i)
        Wenn ch >= 97 dann
            Wenn ch <= 122 dann
                ch = ch - 32
            Ende
        Ende
        raw_setbyte(buf, 8 + i, ch)
        i = i + 1
    Ende
    raw_setbyte(buf, 0, n % 256)
    raw_setbyte(buf, 1, (n / 256) % 256)
    raw_setbyte(buf, 2, (n / 65536) % 256)
    raw_setbyte(buf, 3, (n / 16777216) % 256)
    raw_setbyte(buf, 8 + n, 0)
    gebe_zurueck buf
Ende

// ASCII-Kleinbuchstaben
Funktion str_lower(s)
    n = str_len(s)
    buf = alloc(8 + n + 1)
    i = 0
    Solange i < n
        ch = raw_byteat(s, 8 + i)
        Wenn ch >= 65 dann
            Wenn ch <= 90 dann
                ch = ch + 32
            Ende
        Ende
        raw_setbyte(buf, 8 + i, ch)
        i = i + 1
    Ende
    raw_setbyte(buf, 0, n % 256)
    raw_setbyte(buf, 1, (n / 256) % 256)
    raw_setbyte(buf, 2, (n / 65536) % 256)
    raw_setbyte(buf, 3, (n / 16777216) % 256)
    raw_setbyte(buf, 8 + n, 0)
    gebe_zurueck buf
Ende

// Zeichenkette umdrehen
Funktion str_reverse(s)
    n = str_len(s)
    buf = alloc(8 + n + 1)
    i = 0
    Solange i < n
        raw_setbyte(buf, 8 + i, raw_byteat(s, 8 + n - 1 - i))
        i = i + 1
    Ende
    raw_setbyte(buf, 0, n % 256)
    raw_setbyte(buf, 1, (n / 256) % 256)
    raw_setbyte(buf, 2, (n / 65536) % 256)
    raw_setbyte(buf, 3, (n / 16777216) % 256)
    raw_setbyte(buf, 8 + n, 0)
    gebe_zurueck buf
Ende

// Leerzeichen an Anfang und Ende entfernen
Funktion str_trim(s)
    n = str_len(s)
    a = 0
    fertig = 0
    Solange fertig == 0
        Wenn a >= n dann
            fertig = 1
        Sonst
            Wenn raw_byteat(s, 8 + a) == 32 dann
                a = a + 1
            Sonst
                fertig = 1
            Ende
        Ende
    Ende
    b = n
    fertig = 0
    Solange fertig == 0
        Wenn b <= 0 dann
            fertig = 1
        Sonst
            Wenn raw_byteat(s, 8 + b - 1) == 32 dann
                b = b - 1
            Sonst
                fertig = 1
            Ende
        Ende
    Ende
    Wenn b < a dann
        b = a
    Ende
    gebe_zurueck str_slice(s, a, b - a)
Ende

// 去掉末尾 cut 个字符（StarC 字符串）
Funktion str_cut_tail(s, cut)
    n = str_len(s)
    m = n - cut
    Wenn m < 0 dann
        m = 0
    Ende
    buf = alloc(8 + m + 1)
    i = 0
    Solange i < m
        raw_setbyte(buf, 8 + i, raw_byteat(s, 8 + i))
        i = i + 1
    Ende
    raw_setbyte(buf, 0, m % 256)
    raw_setbyte(buf, 1, (m / 256) % 256)
    raw_setbyte(buf, 2, (m / 65536) % 256)
    raw_setbyte(buf, 3, (m / 16777216) % 256)
    raw_setbyte(buf, 8 + m, 0)
    gebe_zurueck buf
Ende

// Teil einer C-Zeichenkette als StarC-Zeichenkette (start, len)
Funktion c_teil(c, start, len)
    buf = alloc(8 + len + 1)
    raw_setbyte(buf, 0, len % 256)
    raw_setbyte(buf, 1, (len / 256) % 256)
    raw_setbyte(buf, 2, (len / 65536) % 256)
    raw_setbyte(buf, 3, (len / 16777216) % 256)
    i = 0
    Solange i < len
        raw_setbyte(buf, 8 + i, raw_byteat(c, start + i))
        i = i + 1
    Ende
    raw_setbyte(buf, 8 + len, 0)
    gebe_zurueck buf
Ende

// Das n-te Argument (1-basiert) einer C-Zeichenkette ab Position pos.
// Rueckgabe: StarC-Zeichenkette, leer wenn nicht vorhanden.
Funktion argument_n(c, pos, n)
    zaehler = 1
    i = pos
    Solange zaehler < n
        Solange raw_byteat(c, i) == 32
            i = i + 1
        Ende
        Solange raw_byteat(c, i) != 32
            Wenn raw_byteat(c, i) == 0 dann
                gebe_zurueck c_teil(c, 0, 0)
            Ende
            i = i + 1
        Ende
        zaehler = zaehler + 1
    Ende
    Solange raw_byteat(c, i) == 32
        i = i + 1
    Ende
    j = i
    Solange raw_byteat(c, j) != 32
        Wenn raw_byteat(c, j) == 0 dann
            gebe_zurueck c_teil(c, i, j - i)
        Ende
        j = j + 1
    Ende
    gebe_zurueck c_teil(c, i, j - i)
Ende

// Rest einer C-Zeichenkette ab Position pos (bis NUL) als StarC-Zeichenkette
Funktion c_rest(c, pos)
    n = 0
    Solange raw_byteat(c, pos + n) != 0
        n = n + 1
    Ende
    gebe_zurueck c_teil(c, pos, n)
Ende

// Beginnt die Zeichenkette s mit dem Prefix?
Funktion str_starts_with(s, prefix)
    n = str_len(s)
    m = str_len(prefix)
    Wenn m > n dann
        gebe_zurueck 0
    Ende
    i = 0
    Solange i < m
        Wenn raw_byteat(s, 8 + i) != raw_byteat(prefix, 8 + i) dann
            gebe_zurueck 0
        Ende
        i = i + 1
    Ende
    gebe_zurueck 1
Ende

// Basisname eines Pfades: letzter Teil nach / oder \ , ohne Endung .exe/.com
// Beispiel: "C:/Windows/System32/arp.exe" -> "arp"
Funktion basis_name(p)
    n = str_len(p)
    start = 0
    i = n - 1
    Solange i >= 0
        ch = raw_byteat(p, 8 + i)
        Wenn ch == 47 dann
            start = i + 1
            i = -1
        Sonst
            Wenn ch == 92 dann
                start = i + 1
                i = -1
            Sonst
                i = i - 1
            Ende
        Ende
    Ende
    rest = str_slice(p, start, n - start)
    m = str_len(rest)
    Wenn m > 4 dann
        Wenn raw_byteat(rest, 8 + m - 4) == 46 dann
            e1 = raw_byteat(rest, 8 + m - 3)
            e2 = raw_byteat(rest, 8 + m - 2)
            e3 = raw_byteat(rest, 8 + m - 1)
            Wenn e1 == 101 dann
                Wenn e2 == 120 dann
                    Wenn e3 == 101 dann
                        gebe_zurueck str_slice(rest, 0, m - 4)
                    Ende
                Ende
            Ende
        Ende
    Ende
    gebe_zurueck rest
Ende
