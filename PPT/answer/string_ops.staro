// ============================================================================
//  string_ops.staro —— language-bench 考题「String-ops」能力层
//  铁律 E：能力全在 .staro。精确复现 lbgen ref_strings。
//  codepoints=非续字节数（UTF-8 续字节 0x80..0xBF）；spaces=空格数；
//  needle=非重叠 "ee" 计数；checksum=Σ(空格?'_':c)。
//  ★ 无位运算：用算术区间判断续字节（c>=128 && c<=191），0x80..0xBF=128..191。
//  string_run(buf, n) -> 返回 alloc(40)：[n, codepoints, spaces+1, needle, checksum]。
// ============================================================================

Funktion string_run(buf, n)
    codepoints = 0
    spaces = 0
    checksum = 0
    i = 0
    Solange i < n
        c = raw_byteat(buf, i)
        // UTF-8 续字节：0x80..0xBF（等价 (c & 0xC0) == 0x80）
        cont = 0
        Wenn c >= 128 dann
            Wenn c <= 191 dann
                cont = 1
            Ende
        Ende
        Wenn cont == 0 dann
            codepoints = codepoints + 1
        Ende
        Wenn c == 32 dann
            spaces = spaces + 1
            checksum = checksum + 95        // '_'
        Sonst
            checksum = checksum + c
        Ende
        i = i + 1
    Ende

    // needle：非重叠 "ee"
    needle = 0
    i = 0
    Solange i + 1 < n
        c0 = raw_byteat(buf, i)
        c1 = raw_byteat(buf, i + 1)
        Wenn c0 == 101 dann
            Wenn c1 == 101 dann
                needle = needle + 1
                i = i + 2
            Sonst
                i = i + 1
            Ende
        Sonst
            i = i + 1
        Ende
    Ende

    out = alloc(40)
    write_u64(out, 0, n)
    write_u64(out, 8, codepoints)
    write_u64(out, 16, spaces + 1)
    write_u64(out, 24, needle)
    write_u64(out, 32, checksum)
    gebe_zurueck out
Ende
