// inuos/ew_kernel.staro - GPU 元素级内核 PTX 生成 (deepPuTT)
// 依赖: sys.staro, str.staro (str_len)
// silu_mul: out[i] = silu(g[i]) * u[i];  silu(x)=x/(1+exp(-x)); exp 用 ex2*(-x*log2e)
// axpy:     out[i] += w * y[i];  w 是 f32 标量(wptr)
Funktion kstr_emit5(out, off, s)
    n = str_len(s)
    i = 0
    Solange i < n
        raw_setbyte(out, off + i, raw_byteat(s, 8 + i))
        i = i + 1
    Ende
    gebe_zurueck off + n
Ende

// silu_mul(g, u, out, N)
Funktion silu_mul_ptx(out, off)
    off = kstr_emit5(out, off, ".version 7.0\n")
    off = kstr_emit5(out, off, ".target sm_75\n")
    off = kstr_emit5(out, off, ".address_size 64\n")
    off = kstr_emit5(out, off, ".visible .entry silu_mul(.param .u64 g, .param .u64 u, .param .u64 out, .param .u32 N) {\n")
    off = kstr_emit5(out, off, ".reg .u32 %i, %N, %t1, %t2;\n")
    off = kstr_emit5(out, off, ".reg .u64 %rg, %ru, %ro, %addr, %addr2;\n")
    off = kstr_emit5(out, off, ".reg .f32 %g, %u, %ng, %e, %d, %s, %r;\n")
    off = kstr_emit5(out, off, ".reg .pred %p;\n")
    off = kstr_emit5(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit5(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit5(out, off, "mul.lo.u32 %i, %t1, %t2;\n")
    off = kstr_emit5(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit5(out, off, "add.u32 %i, %i, %t1;\n")
    off = kstr_emit5(out, off, "ld.param.u32 %N, [N];\n")
    off = kstr_emit5(out, off, "setp.ge.u32 %p, %i, %N;\n")
    off = kstr_emit5(out, off, "@%p bra EXIT;\n")
    off = kstr_emit5(out, off, "ld.param.u64 %rg, [g];\n")
    off = kstr_emit5(out, off, "ld.param.u64 %ru, [u];\n")
    off = kstr_emit5(out, off, "ld.param.u64 %ro, [out];\n")
    off = kstr_emit5(out, off, "mul.wide.u32 %addr, %i, 4;\n")
    off = kstr_emit5(out, off, "add.u64 %addr, %rg, %addr;\n")
    off = kstr_emit5(out, off, "ld.global.f32 %g, [%addr];\n")
    off = kstr_emit5(out, off, "mul.wide.u32 %addr2, %i, 4;\n")
    off = kstr_emit5(out, off, "add.u64 %addr2, %ru, %addr2;\n")
    off = kstr_emit5(out, off, "ld.global.f32 %u, [%addr2];\n")
    off = kstr_emit5(out, off, "neg.f32 %ng, %g;\n")
    off = kstr_emit5(out, off, "mul.f32 %e, %ng, 0f3FB8AA3B;\n")
    off = kstr_emit5(out, off, "ex2.approx.f32 %e, %e;\n")
    off = kstr_emit5(out, off, "add.f32 %d, %e, 0f3F800000;\n")
    off = kstr_emit5(out, off, "div.rn.f32 %s, %g, %d;\n")
    off = kstr_emit5(out, off, "mul.f32 %r, %s, %u;\n")
    // swiglu_limit=10 钳位: out = clamp(silu(g)*u, -10, 10)
    off = kstr_emit5(out, off, "min.f32 %r, %r, 0f41200000;\n")
    off = kstr_emit5(out, off, "max.f32 %r, %r, 0fC1200000;\n")
    off = kstr_emit5(out, off, "mul.wide.u32 %addr2, %i, 4;\n")
    off = kstr_emit5(out, off, "add.u64 %addr2, %ro, %addr2;\n")
    off = kstr_emit5(out, off, "st.global.f32 [%addr2], %r;\n")
    off = kstr_emit5(out, off, "EXIT:\n")
    off = kstr_emit5(out, off, "ret;\n")
    off = kstr_emit5(out, off, "}\n")
    gebe_zurueck off
Ende

// axpy(y, wptr, out, N): out[i] += w * y[i]
Funktion axpy_ptx(out, off)
    off = kstr_emit5(out, off, ".version 7.0\n")
    off = kstr_emit5(out, off, ".target sm_75\n")
    off = kstr_emit5(out, off, ".address_size 64\n")
    off = kstr_emit5(out, off, ".visible .entry axpy(.param .u64 y, .param .u64 wptr, .param .u64 out, .param .u32 N) {\n")
    off = kstr_emit5(out, off, ".reg .u32 %i, %N, %t1, %t2;\n")
    off = kstr_emit5(out, off, ".reg .u64 %ry, %rw, %ro, %addr, %addr2;\n")
    off = kstr_emit5(out, off, ".reg .f32 %y, %w, %v, %acc;\n")
    off = kstr_emit5(out, off, ".reg .pred %p;\n")
    off = kstr_emit5(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit5(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit5(out, off, "mul.lo.u32 %i, %t1, %t2;\n")
    off = kstr_emit5(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit5(out, off, "add.u32 %i, %i, %t1;\n")
    off = kstr_emit5(out, off, "ld.param.u32 %N, [N];\n")
    off = kstr_emit5(out, off, "setp.ge.u32 %p, %i, %N;\n")
    off = kstr_emit5(out, off, "@%p bra EXIT;\n")
    off = kstr_emit5(out, off, "ld.param.u64 %ry, [y];\n")
    off = kstr_emit5(out, off, "ld.param.u64 %rw, [wptr];\n")
    off = kstr_emit5(out, off, "ld.param.u64 %ro, [out];\n")
    off = kstr_emit5(out, off, "ld.global.f32 %w, [%rw];\n")
    off = kstr_emit5(out, off, "mul.wide.u32 %addr, %i, 4;\n")
    off = kstr_emit5(out, off, "add.u64 %addr, %ry, %addr;\n")
    off = kstr_emit5(out, off, "ld.global.f32 %y, [%addr];\n")
    off = kstr_emit5(out, off, "mul.wide.u32 %addr2, %i, 4;\n")
    off = kstr_emit5(out, off, "add.u64 %addr2, %ro, %addr2;\n")
    off = kstr_emit5(out, off, "ld.global.f32 %acc, [%addr2];\n")
    off = kstr_emit5(out, off, "fma.rn.f32 %v, %w, %y, %acc;\n")
    off = kstr_emit5(out, off, "st.global.f32 [%addr2], %v;\n")
    off = kstr_emit5(out, off, "EXIT:\n")
    off = kstr_emit5(out, off, "ret;\n")
    off = kstr_emit5(out, off, "}\n")
    gebe_zurueck off
Ende
