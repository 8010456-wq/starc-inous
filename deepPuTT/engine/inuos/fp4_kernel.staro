// inuos/fp4_kernel.staro - GPU FP4 反量化内核 PTX 生成 (deepPuTT)
// 依赖: sys.staro, str.staro (str_len)
//
// 内核 fp4deq: 每线程 1 元素, 读 weight 字节 -> nibble -> LUT[nib] -> *2^k -> fp32
// 参数: w(u64 weight字节) kp(u64 scale指数s32数组) lut(u64 LUT fp32) out(u64) n(u32)
// k = e8m0_exp(scale_byte) = scale_byte - 127, 由 CPU(StarC) 预计算为 s32 数组
// 2^k 用 ex2.approx.f32 (sm_75 支持)
// 布局: grid.x*block.x = ceil(n/block), 每线程 1 元素

// 字符串写入辅助: 复制 StarC 字符串 s 到 out[off..], 返回新 off
Funktion kstr_emit(out, off, s)
    n = str_len(s)
    i = 0
    Solange i < n
        raw_setbyte(out, off + i, raw_byteat(s, 8 + i))
        i = i + 1
    Ende
    gebe_zurueck off + n
Ende

// 生成 fp4deq 内核 PTX 到 out, 返回新 off (调用方末尾补 0)
Funktion fp4deq_ptx(out, off)
    off = kstr_emit(out, off, ".version 7.0\n")
    off = kstr_emit(out, off, ".target sm_75\n")
    off = kstr_emit(out, off, ".address_size 64\n")
    off = kstr_emit(out, off, ".visible .entry fp4deq(.param .u64 w, .param .u64 kp, .param .u64 lut, .param .u64 out, .param .u32 n) {\n")
    off = kstr_emit(out, off, ".reg .u32 %e, %nreg, %bi, %nib, %e0, %u, %kk, %cb, %cn, %ct;\n")
    off = kstr_emit(out, off, ".reg .u64 %rw, %rk, %rl, %ro, %addr, %addr2;\n")
    off = kstr_emit(out, off, ".reg .u8 %ub;\n")
    off = kstr_emit(out, off, ".reg .f32 %f, %fk, %res;\n")
    off = kstr_emit(out, off, ".reg .pred %p, %p2;\n")
    // e = blockIdx.x*blockDim.x + threadIdx.x (特殊寄存器须 mov 到普通寄存器)
    off = kstr_emit(out, off, "mov.u32 %cb, %ctaid.x;\n")
    off = kstr_emit(out, off, "mov.u32 %cn, %ntid.x;\n")
    off = kstr_emit(out, off, "mov.u32 %ct, %tid.x;\n")
    off = kstr_emit(out, off, "mul.lo.u32 %e, %cb, %cn;\n")
    off = kstr_emit(out, off, "add.u32 %e, %e, %ct;\n")
    off = kstr_emit(out, off, "ld.param.u32 %nreg, [n];\n")
    off = kstr_emit(out, off, "setp.ge.u32 %p, %e, %nreg;\n")
    off = kstr_emit(out, off, "@%p bra EXIT;\n")
    // byte = w[e/2]
    off = kstr_emit(out, off, "ld.param.u64 %rw, [w];\n")
    off = kstr_emit(out, off, "shr.u32 %bi, %e, 1;\n")
    off = kstr_emit(out, off, "cvt.u64.u32 %addr, %bi;\n")
    off = kstr_emit(out, off, "add.u64 %addr, %rw, %addr;\n")
    off = kstr_emit(out, off, "ld.global.u8 %ub, [%addr];\n")
    off = kstr_emit(out, off, "cvt.u32.u8 %u, %ub;\n")
    // nib = (e&1)? high : low
    off = kstr_emit(out, off, "and.b32 %nib, %u, 15;\n")
    off = kstr_emit(out, off, "and.b32 %e0, %e, 1;\n")
    off = kstr_emit(out, off, "setp.eq.u32 %p2, %e0, 1;\n")
    off = kstr_emit(out, off, "@%p2 bra HIGH;\n")
    off = kstr_emit(out, off, "bra LUTLOAD;\n")
    off = kstr_emit(out, off, "HIGH:\n")
    off = kstr_emit(out, off, "shr.u32 %nib, %u, 4;\n")
    // f = lut[nib]
    off = kstr_emit(out, off, "LUTLOAD:\n")
    off = kstr_emit(out, off, "ld.param.u64 %rl, [lut];\n")
    off = kstr_emit(out, off, "mul.wide.u32 %addr, %nib, 4;\n")
    off = kstr_emit(out, off, "add.u64 %addr, %rl, %addr;\n")
    off = kstr_emit(out, off, "ld.global.f32 %f, [%addr];\n")
    // k = kp[e/32]; res = f * 2^k
    off = kstr_emit(out, off, "ld.param.u64 %rk, [kp];\n")
    off = kstr_emit(out, off, "shr.u32 %bi, %e, 5;\n")
    off = kstr_emit(out, off, "mul.wide.u32 %addr, %bi, 4;\n")
    off = kstr_emit(out, off, "add.u64 %addr, %rk, %addr;\n")
    off = kstr_emit(out, off, "ld.global.s32 %kk, [%addr];\n")
    off = kstr_emit(out, off, "cvt.rn.f32.s32 %fk, %kk;\n")
    off = kstr_emit(out, off, "ex2.approx.f32 %fk, %fk;\n")
    off = kstr_emit(out, off, "mul.f32 %res, %f, %fk;\n")
    // out[e] = res
    off = kstr_emit(out, off, "ld.param.u64 %ro, [out];\n")
    off = kstr_emit(out, off, "mul.wide.u32 %addr2, %e, 4;\n")
    off = kstr_emit(out, off, "add.u64 %addr, %ro, %addr2;\n")
    off = kstr_emit(out, off, "st.global.f32 [%addr], %res;\n")
    off = kstr_emit(out, off, "EXIT:\n")
    off = kstr_emit(out, off, "ret;\n")
    off = kstr_emit(out, off, "}\n")
    gebe_zurueck off
Ende

// ===== GPU pow 生成内核 (pow[i] = 2^(sbase[i]-127)) =====
// sbase: u8 scale (E8M0), pow: fp32 输出, n: 元素数
Funktion powgen_ptx(out, off)
    off = kstr_emit(out, off, ".version 7.0\n")
    off = kstr_emit(out, off, ".target sm_75\n")
    off = kstr_emit(out, off, ".address_size 64\n")
    off = kstr_emit(out, off, ".visible .entry powgen(.param .u64 sb, .param .u64 pw, .param .u32 n) {\n")
    off = kstr_emit(out, off, ".reg .u32 %e, %n, %nb, %t1, %t2;\n")
    off = kstr_emit(out, off, ".reg .u64 %rsb, %rpw, %a;\n")
    off = kstr_emit(out, off, ".reg .u8 %ub;\n")
    off = kstr_emit(out, off, ".reg .f32 %f;\n")
    off = kstr_emit(out, off, ".reg .pred %p;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit(out, off, "mul.lo.u32 %e, %t1, %t2;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit(out, off, "add.u32 %e, %e, %t1;\n")
    off = kstr_emit(out, off, "ld.param.u32 %n, [n];\n")
    off = kstr_emit(out, off, "setp.ge.u32 %p, %e, %n;\n")
    off = kstr_emit(out, off, "@%p bra EXIT;\n")
    off = kstr_emit(out, off, "ld.param.u64 %rsb, [sb];\n")
    off = kstr_emit(out, off, "ld.param.u64 %rpw, [pw];\n")
    off = kstr_emit(out, off, "cvt.u64.u32 %a, %e;\n")
    off = kstr_emit(out, off, "add.u64 %a, %rsb, %a;\n")
    off = kstr_emit(out, off, "ld.global.u8 %ub, [%a];\n")
    off = kstr_emit(out, off, "cvt.u32.u8 %nb, %ub;\n")
    off = kstr_emit(out, off, "sub.u32 %nb, %nb, 127;\n")
    off = kstr_emit(out, off, "cvt.rn.f32.s32 %f, %nb;\n")
    off = kstr_emit(out, off, "ex2.approx.f32 %f, %f;\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %e, 4;\n")
    off = kstr_emit(out, off, "add.u64 %a, %rpw, %a;\n")
    off = kstr_emit(out, off, "st.global.f32 [%a], %f;\n")
    off = kstr_emit(out, off, "EXIT:\n")
    off = kstr_emit(out, off, "ret;\n")
    off = kstr_emit(out, off, "}\n")
    gebe_zurueck off
Ende
//   w: I8 每字节 2 个 FP4 (低 nibble=元素2k, 高=2k+1); lut: 16 fp32; pow2: fp32[2^(scale-127)] 按 m*ncb32+k/32
// 参数: w(u64) lut(u64) pow2(u64) act(u64) out(u64) M(u32) K(u32) ncb32(u32)
Funktion fp4gemv_ptx(out, off)
    off = kstr_emit(out, off, ".version 7.0\n")
    off = kstr_emit(out, off, ".target sm_75\n")
    off = kstr_emit(out, off, ".address_size 64\n")
    off = kstr_emit(out, off, ".visible .entry fp4gemv(.param .u64 w, .param .u64 lut, .param .u64 pow2, .param .u64 act, .param .u64 out, .param .u32 M, .param .u32 K, .param .u32 ncb32) {\n")
    off = kstr_emit(out, off, ".reg .u32 %m, %M, %K, %ncb, %k, %bi, %blk, %e0, %t1, %t2, %halfK;\n")
    off = kstr_emit(out, off, ".reg .u64 %rw, %rl, %rp, %ra, %ro, %addr, %addr2;\n")
    off = kstr_emit(out, off, ".reg .u8 %ub;\n")
    off = kstr_emit(out, off, ".reg .f32 %f, %fk, %a, %acc;\n")
    off = kstr_emit(out, off, ".reg .pred %p;\n")
    // m = blockIdx*blockDim + threadIdx
    off = kstr_emit(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit(out, off, "mul.lo.u32 %m, %t1, %t2;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit(out, off, "add.u32 %m, %m, %t1;\n")
    off = kstr_emit(out, off, "ld.param.u32 %M, [M];\n")
    off = kstr_emit(out, off, "setp.ge.u32 %p, %m, %M;\n")
    off = kstr_emit(out, off, "@%p bra EXIT;\n")
    off = kstr_emit(out, off, "ld.param.u64 %rw, [w];\n")
    off = kstr_emit(out, off, "ld.param.u64 %rl, [lut];\n")
    off = kstr_emit(out, off, "ld.param.u64 %rp, [pow2];\n")
    off = kstr_emit(out, off, "ld.param.u64 %ra, [act];\n")
    off = kstr_emit(out, off, "ld.param.u64 %ro, [out];\n")
    off = kstr_emit(out, off, "ld.param.u32 %K, [K];\n")
    off = kstr_emit(out, off, "ld.param.u32 %ncb, [ncb32];\n")
    off = kstr_emit(out, off, "mov.f32 %acc, 0f00000000;\n")
    off = kstr_emit(out, off, "shr.u32 %halfK, %K, 1;\n")
    off = kstr_emit(out, off, "mov.u32 %k, 0;\n")
    off = kstr_emit(out, off, "LOOP:\n")
    off = kstr_emit(out, off, "setp.ge.u32 %p, %k, %K;\n")
    off = kstr_emit(out, off, "@%p bra DONE;\n")
    // bi = m*halfK + k/2
    off = kstr_emit(out, off, "mul.lo.u32 %bi, %m, %halfK;\n")
    off = kstr_emit(out, off, "shr.u32 %t1, %k, 1;\n")
    off = kstr_emit(out, off, "add.u32 %bi, %bi, %t1;\n")
    off = kstr_emit(out, off, "cvt.u64.u32 %addr, %bi;\n")
    off = kstr_emit(out, off, "add.u64 %addr, %rw, %addr;\n")
    off = kstr_emit(out, off, "ld.global.u8 %ub, [%addr];\n")
    off = kstr_emit(out, off, "cvt.u32.u8 %e0, %ub;\n")
    // nibble: k%2==0 低 nibble, 否则高 nibble (先判奇偶再取, 不能先 and 15 再 shr)
    off = kstr_emit(out, off, "and.b32 %t2, %k, 1;\n")
    off = kstr_emit(out, off, "setp.eq.u32 %p, %t2, 0;\n")
    off = kstr_emit(out, off, "@%p bra EVEN;\n")
    off = kstr_emit(out, off, "shr.u32 %e0, %e0, 4;\n")
    off = kstr_emit(out, off, "and.b32 %e0, %e0, 15;\n")
    off = kstr_emit(out, off, "bra GOTNIB;\n")
    off = kstr_emit(out, off, "EVEN:\n")
    off = kstr_emit(out, off, "and.b32 %e0, %e0, 15;\n")
    off = kstr_emit(out, off, "GOTNIB:\n")
    // f = lut[e0]
    off = kstr_emit(out, off, "mul.wide.u32 %addr2, %e0, 4;\n")
    off = kstr_emit(out, off, "add.u64 %addr2, %rl, %addr2;\n")
    off = kstr_emit(out, off, "ld.global.f32 %f, [%addr2];\n")
    // blk = m*ncb + k/32 ; f *= pow2[blk]
    off = kstr_emit(out, off, "mul.lo.u32 %t1, %m, %ncb;\n")
    off = kstr_emit(out, off, "shr.u32 %t2, %k, 5;\n")
    off = kstr_emit(out, off, "add.u32 %blk, %t1, %t2;\n")
    off = kstr_emit(out, off, "mul.wide.u32 %addr2, %blk, 4;\n")
    off = kstr_emit(out, off, "add.u64 %addr2, %rp, %addr2;\n")
    off = kstr_emit(out, off, "ld.global.f32 %fk, [%addr2];\n")
    off = kstr_emit(out, off, "mul.f32 %f, %f, %fk;\n")
    // a = act[k]; acc = fma(a, f, acc)
    off = kstr_emit(out, off, "mul.wide.u32 %addr2, %k, 4;\n")
    off = kstr_emit(out, off, "add.u64 %addr2, %ra, %addr2;\n")
    off = kstr_emit(out, off, "ld.global.f32 %a, [%addr2];\n")
    off = kstr_emit(out, off, "fma.rn.f32 %acc, %a, %f, %acc;\n")
    off = kstr_emit(out, off, "add.u32 %k, %k, 1;\n")
    off = kstr_emit(out, off, "bra LOOP;\n")
    off = kstr_emit(out, off, "DONE:\n")
    off = kstr_emit(out, off, "mul.wide.u32 %addr2, %m, 4;\n")
    off = kstr_emit(out, off, "add.u64 %addr2, %ro, %addr2;\n")
    off = kstr_emit(out, off, "st.global.f32 [%addr2], %acc;\n")
    off = kstr_emit(out, off, "EXIT:\n")
    off = kstr_emit(out, off, "ret;\n")
    off = kstr_emit(out, off, "}\n")
    gebe_zurueck off
Ende

// silu_clamp: 门激活合并, 复刻 moe_forward CPU 循环
//   out[e] = silu(clamp(g[e])) * clamp(u[e]); clamp(x): x>8->8, x<-8->-8
// 参数: g(u64) u(u64) o(u64) n(u32)
Funktion silu_clamp_ptx(out, off)
    off = kstr_emit(out, off, ".version 7.0\n")
    off = kstr_emit(out, off, ".target sm_75\n")
    off = kstr_emit(out, off, ".address_size 64\n")
    off = kstr_emit(out, off, ".visible .entry silu_clamp(.param .u64 g, .param .u64 u, .param .u64 o, .param .u32 n) {\n")
    off = kstr_emit(out, off, ".reg .u32 %e, %n, %t1, %t2;\n")
    off = kstr_emit(out, off, ".reg .u64 %rg, %ru, %ro, %a, %a2;\n")
    off = kstr_emit(out, off, ".reg .f32 %f, %x, %uv, %s;\n")
    off = kstr_emit(out, off, ".reg .pred %p;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit(out, off, "mul.lo.u32 %e, %t1, %t2;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit(out, off, "add.u32 %e, %e, %t1;\n")
    off = kstr_emit(out, off, "ld.param.u32 %n, [n];\n")
    off = kstr_emit(out, off, "setp.ge.u32 %p, %e, %n;\n")
    off = kstr_emit(out, off, "@%p bra EXIT;\n")
    off = kstr_emit(out, off, "ld.param.u64 %rg, [g];\n")
    off = kstr_emit(out, off, "ld.param.u64 %ru, [u];\n")
    off = kstr_emit(out, off, "ld.param.u64 %ro, [o];\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %e, 4;\n")
    off = kstr_emit(out, off, "add.u64 %a2, %rg, %a;\n")
    off = kstr_emit(out, off, "add.u64 %a, %ru, %a;\n")
    off = kstr_emit(out, off, "ld.global.f32 %f, [%a2];\n")
    off = kstr_emit(out, off, "mov.f32 %x, 0f41000000;\n")
    off = kstr_emit(out, off, "setp.gt.f32 %p, %f, %x;\n")
    off = kstr_emit(out, off, "@%p mov.f32 %f, %x;\n")
    off = kstr_emit(out, off, "ld.global.f32 %uv, [%a];\n")
    off = kstr_emit(out, off, "setp.gt.f32 %p, %uv, %x;\n")
    off = kstr_emit(out, off, "@%p mov.f32 %uv, %x;\n")
    off = kstr_emit(out, off, "mov.f32 %x, 0fC1000000;\n")
    off = kstr_emit(out, off, "setp.lt.f32 %p, %uv, %x;\n")
    off = kstr_emit(out, off, "@%p mov.f32 %uv, %x;\n")
    off = kstr_emit(out, off, "mov.f32 %x, 0f3FB8AA3B;\n")
    off = kstr_emit(out, off, "mul.f32 %s, %f, %x;\n")
    off = kstr_emit(out, off, "neg.f32 %s, %s;\n")
    off = kstr_emit(out, off, "ex2.approx.f32 %s, %s;\n")
    off = kstr_emit(out, off, "add.f32 %s, %s, 0f3F800000;\n")
    off = kstr_emit(out, off, "rcp.approx.f32 %s, %s;\n")
    off = kstr_emit(out, off, "mul.f32 %f, %f, %s;\n")
    off = kstr_emit(out, off, "mul.f32 %f, %f, %uv;\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %e, 4;\n")
    off = kstr_emit(out, off, "add.u64 %a, %ro, %a;\n")
    off = kstr_emit(out, off, "st.global.f32 [%a], %f;\n")
    off = kstr_emit(out, off, "EXIT:\n")
    off = kstr_emit(out, off, "ret;\n")
    off = kstr_emit(out, off, "}\n")
    gebe_zurueck off
Ende

// accum_scale: y[e] += w * in[e]
// 参数: y(u64) in(u64) w(f32) n(u32)
Funktion accum_scale_ptx(out, off)
    off = kstr_emit(out, off, ".version 7.0\n")
    off = kstr_emit(out, off, ".target sm_75\n")
    off = kstr_emit(out, off, ".address_size 64\n")
    off = kstr_emit(out, off, ".visible .entry accum_scale(.param .u64 y, .param .u64 in, .param .f32 w, .param .u32 n) {\n")
    off = kstr_emit(out, off, ".reg .u32 %e, %n, %t1, %t2;\n")
    off = kstr_emit(out, off, ".reg .u64 %ry, %ri, %a, %a2;\n")
    off = kstr_emit(out, off, ".reg .f32 %f, %x, %w;\n")
    off = kstr_emit(out, off, ".reg .pred %p;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit(out, off, "mul.lo.u32 %e, %t1, %t2;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit(out, off, "add.u32 %e, %e, %t1;\n")
    off = kstr_emit(out, off, "ld.param.u32 %n, [n];\n")
    off = kstr_emit(out, off, "setp.ge.u32 %p, %e, %n;\n")
    off = kstr_emit(out, off, "@%p bra EXIT;\n")
    off = kstr_emit(out, off, "ld.param.u64 %ri, [in];\n")
    off = kstr_emit(out, off, "ld.param.u64 %ry, [y];\n")
    off = kstr_emit(out, off, "ld.param.f32 %w, [w];\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %e, 4;\n")
    off = kstr_emit(out, off, "add.u64 %a2, %ri, %a;\n")
    off = kstr_emit(out, off, "ld.global.f32 %f, [%a2];\n")
    off = kstr_emit(out, off, "mul.f32 %f, %f, %w;\n")
    off = kstr_emit(out, off, "add.u64 %a2, %ry, %a;\n")
    off = kstr_emit(out, off, "ld.global.f32 %x, [%a2];\n")
    off = kstr_emit(out, off, "add.f32 %x, %x, %f;\n")
    off = kstr_emit(out, off, "st.global.f32 [%a2], %x;\n")
    off = kstr_emit(out, off, "EXIT:\n")
    off = kstr_emit(out, off, "ret;\n")
    off = kstr_emit(out, off, "}\n")
    gebe_zurueck off
Ende
// mhc_post: post_out[c*4096+d] = postw[c]*y[d] + sum_{j<4} comb[c*4+j]*x[j*4096+d]
// 参数: y(u64) x(u64) postw(u64) comb(u64) out(u64)
Funktion mhc_post_ptx(out, off)
    off = kstr_emit(out, off, ".version 7.0\n")
    off = kstr_emit(out, off, ".target sm_75\n")
    off = kstr_emit(out, off, ".address_size 64\n")
    off = kstr_emit(out, off, ".visible .entry mhc_post(.param .u64 y, .param .u64 x, .param .u64 postw, .param .u64 comb, .param .u64 out) {\n")
    off = kstr_emit(out, off, ".reg .u32 %e, %c, %d, %j, %t1, %t2;\n")
    off = kstr_emit(out, off, ".reg .u64 %ry, %rx, %rpo, %rc, %ro, %a, %a2;\n")
    off = kstr_emit(out, off, ".reg .f32 %acc, %pv, %yv, %cv;\n")
    off = kstr_emit(out, off, ".reg .pred %p;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit(out, off, "mul.lo.u32 %e, %t1, %t2;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit(out, off, "add.u32 %e, %e, %t1;\n")
    off = kstr_emit(out, off, "setp.ge.u32 %p, %e, 16384;\n")
    off = kstr_emit(out, off, "@%p bra EXIT;\n")
    off = kstr_emit(out, off, "ld.param.u64 %ry, [y];\n")
    off = kstr_emit(out, off, "ld.param.u64 %rx, [x];\n")
    off = kstr_emit(out, off, "ld.param.u64 %rpo, [postw];\n")
    off = kstr_emit(out, off, "ld.param.u64 %rc, [comb];\n")
    off = kstr_emit(out, off, "ld.param.u64 %ro, [out];\n")
    off = kstr_emit(out, off, "div.u32 %c, %e, 4096;\n")
    off = kstr_emit(out, off, "rem.u32 %d, %e, 4096;\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %c, 4;\n")
    off = kstr_emit(out, off, "add.u64 %a, %rpo, %a;\n")
    off = kstr_emit(out, off, "ld.global.f32 %pv, [%a];\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %d, 4;\n")
    off = kstr_emit(out, off, "add.u64 %a, %ry, %a;\n")
    off = kstr_emit(out, off, "ld.global.f32 %yv, [%a];\n")
    off = kstr_emit(out, off, "mul.f32 %acc, %pv, %yv;\n")
    off = kstr_emit(out, off, "mov.u32 %j, 0;\n")
    off = kstr_emit(out, off, "LOOP:\n")
    off = kstr_emit(out, off, "setp.ge.u32 %p, %j, 4;\n")
    off = kstr_emit(out, off, "@%p bra LOOPEND;\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %c, 16;\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a2, %j, 4;\n")
    off = kstr_emit(out, off, "add.u64 %a, %a, %a2;\n")
    off = kstr_emit(out, off, "add.u64 %a, %rc, %a;\n")
    off = kstr_emit(out, off, "ld.global.f32 %cv, [%a];\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %d, 4;\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a2, %j, 16384;\n")
    off = kstr_emit(out, off, "add.u64 %a, %a, %a2;\n")
    off = kstr_emit(out, off, "add.u64 %a, %rx, %a;\n")
    off = kstr_emit(out, off, "ld.global.f32 %pv, [%a];\n")
    off = kstr_emit(out, off, "fma.rn.f32 %acc, %cv, %pv, %acc;\n")
    off = kstr_emit(out, off, "add.u32 %j, %j, 1;\n")
    off = kstr_emit(out, off, "bra LOOP;\n")
    off = kstr_emit(out, off, "LOOPEND:\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %e, 4;\n")
    off = kstr_emit(out, off, "add.u64 %a, %ro, %a;\n")
    off = kstr_emit(out, off, "st.global.f32 [%a], %acc;\n")
    off = kstr_emit(out, off, "EXIT:\n")
    off = kstr_emit(out, off, "ret;\n")
    off = kstr_emit(out, off, "}\n")
    gebe_zurueck off
Ende

// mhc_y: y[d] = sum_{c<4} prew[c]*x[c*4096+d], d<4096  (mhc_pre 输出投影)
// 参数: x(u64) prew(u64) y(u64)
Funktion mhc_y_ptx(out, off)
    off = kstr_emit(out, off, ".version 7.0\n")
    off = kstr_emit(out, off, ".target sm_75\n")
    off = kstr_emit(out, off, ".address_size 64\n")
    off = kstr_emit(out, off, ".visible .entry mhc_y(.param .u64 x, .param .u64 prew, .param .u64 y) {\n")
    off = kstr_emit(out, off, ".reg .u32 %e, %c, %d, %t1, %t2;\n")
    off = kstr_emit(out, off, ".reg .u64 %rx, %rp, %ry, %a, %a2;\n")
    off = kstr_emit(out, off, ".reg .f32 %acc, %pv, %cv;\n")
    off = kstr_emit(out, off, ".reg .pred %p;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit(out, off, "mul.lo.u32 %e, %t1, %t2;\n")
    off = kstr_emit(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit(out, off, "add.u32 %e, %e, %t1;\n")
    off = kstr_emit(out, off, "setp.ge.u32 %p, %e, 4096;\n")
    off = kstr_emit(out, off, "@%p bra EXIT;\n")
    off = kstr_emit(out, off, "ld.param.u64 %rx, [x];\n")
    off = kstr_emit(out, off, "ld.param.u64 %rp, [prew];\n")
    off = kstr_emit(out, off, "ld.param.u64 %ry, [y];\n")
    off = kstr_emit(out, off, "mov.u32 %d, %e;\n")
    off = kstr_emit(out, off, "mov.f32 %acc, 0f00000000;\n")
    off = kstr_emit(out, off, "mov.u32 %c, 0;\n")
    off = kstr_emit(out, off, "LOOP:\n")
    off = kstr_emit(out, off, "setp.ge.u32 %p, %c, 4;\n")
    off = kstr_emit(out, off, "@%p bra LOOPEND;\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %c, 4;\n")
    off = kstr_emit(out, off, "add.u64 %a, %rp, %a;\n")
    off = kstr_emit(out, off, "ld.global.f32 %cv, [%a];\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %d, 4;\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a2, %c, 16384;\n")
    off = kstr_emit(out, off, "add.u64 %a, %a, %a2;\n")
    off = kstr_emit(out, off, "add.u64 %a, %rx, %a;\n")
    off = kstr_emit(out, off, "ld.global.f32 %pv, [%a];\n")
    off = kstr_emit(out, off, "fma.rn.f32 %acc, %cv, %pv, %acc;\n")
    off = kstr_emit(out, off, "add.u32 %c, %c, 1;\n")
    off = kstr_emit(out, off, "bra LOOP;\n")
    off = kstr_emit(out, off, "LOOPEND:\n")
    off = kstr_emit(out, off, "mul.wide.u32 %a, %d, 4;\n")
    off = kstr_emit(out, off, "add.u64 %a, %ry, %a;\n")
    off = kstr_emit(out, off, "st.global.f32 [%a], %acc;\n")
    off = kstr_emit(out, off, "EXIT:\n")
    off = kstr_emit(out, off, "ret;\n")
    off = kstr_emit(out, off, "}\n")
    gebe_zurueck off
Ende
