// inuos/gemv_kernel.staro - GPU 融合 FP4反量化+GEMV 内核 PTX 生成 (deepPuTT)
// 依赖: sys.staro, str.staro (str_len)
//
// 内核 fp4gemv: 每线程算输出行 m 的 out[m] = sum_k act[k] * dequant(w[m,k])
//   w: I8 每字节2个FP4; sc: F8_E8M0 scale(每32元素1个); kp: s32 指数数组; lut: fp32 LUT
//   反量化在行内联完成 (fuse), 输出 fp32
// 参数: w(u64) kp(u64) lut(u64) act(u64) out(u64) M(u32) K(u32)
// 布局: grid.x*block.x >= M, 每线程 1 输出行

Funktion kstr_emit2(out, off, s)
    n = str_len(s)
    i = 0
    Solange i < n
        raw_setbyte(out, off + i, raw_byteat(s, 8 + i))
        i = i + 1
    Ende
    gebe_zurueck off + n
Ende

// 生成 fp4gemv 内核 PTX 到 out, 返回新 off (调用方末尾补 0)
Funktion fp4gemv_ptx(out, off)
    off = kstr_emit2(out, off, ".version 7.0\n")
    off = kstr_emit2(out, off, ".target sm_75\n")
    off = kstr_emit2(out, off, ".address_size 64\n")
    off = kstr_emit2(out, off, ".visible .entry fp4gemv(.param .u64 w, .param .u64 kp, .param .u64 lut, .param .u64 act, .param .u64 out, .param .u32 M, .param .u32 K) {\n")
    off = kstr_emit2(out, off, ".reg .u32 %m, %M, %K, %K2, %K32, %k, %bi, %nib, %e0, %t1, %t2;\n")
    off = kstr_emit2(out, off, ".reg .u64 %rw, %rk, %rl, %ra, %ro, %addr, %addr2;\n")
    off = kstr_emit2(out, off, ".reg .u8 %ub;\n")
    off = kstr_emit2(out, off, ".reg .f32 %f, %fk, %a, %acc;\n")
    off = kstr_emit2(out, off, ".reg .pred %p, %p2;\n")
    // m = blockIdx*blockDim + threadIdx
    off = kstr_emit2(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit2(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit2(out, off, "mul.lo.u32 %m, %t1, %t2;\n")
    off = kstr_emit2(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit2(out, off, "add.u32 %m, %m, %t1;\n")
    off = kstr_emit2(out, off, "ld.param.u32 %M, [M];\n")
    off = kstr_emit2(out, off, "setp.ge.u32 %p, %m, %M;\n")
    off = kstr_emit2(out, off, "@%p bra EXIT;\n")
    off = kstr_emit2(out, off, "ld.param.u64 %rw, [w];\n")
    off = kstr_emit2(out, off, "ld.param.u64 %rk, [kp];\n")
    off = kstr_emit2(out, off, "ld.param.u64 %rl, [lut];\n")
    off = kstr_emit2(out, off, "ld.param.u64 %ra, [act];\n")
    off = kstr_emit2(out, off, "ld.param.u64 %ro, [out];\n")
    off = kstr_emit2(out, off, "ld.param.u32 %K, [K];\n")
    off = kstr_emit2(out, off, "shr.u32 %K2, %K, 1;\n")
    off = kstr_emit2(out, off, "shr.u32 %K32, %K, 5;\n")
    off = kstr_emit2(out, off, "mov.f32 %acc, 0f00000000;\n")
    off = kstr_emit2(out, off, "mov.u32 %k, 0;\n")
    off = kstr_emit2(out, off, "LOOP:\n")
    off = kstr_emit2(out, off, "setp.ge.u32 %p, %k, %K;\n")
    off = kstr_emit2(out, off, "@%p bra DONE;\n")
    // byte_idx = m*K2 + k/2
    off = kstr_emit2(out, off, "mul.lo.u32 %bi, %m, %K2;\n")
    off = kstr_emit2(out, off, "shr.u32 %t1, %k, 1;\n")
    off = kstr_emit2(out, off, "add.u32 %bi, %bi, %t1;\n")
    off = kstr_emit2(out, off, "cvt.u64.u32 %addr, %bi;\n")
    off = kstr_emit2(out, off, "add.u64 %addr, %rw, %addr;\n")
    off = kstr_emit2(out, off, "ld.global.u8 %ub, [%addr];\n")
    off = kstr_emit2(out, off, "cvt.u32.u8 %e0, %ub;\n")
    off = kstr_emit2(out, off, "and.b32 %nib, %e0, 15;\n")
    off = kstr_emit2(out, off, "and.b32 %t1, %k, 1;\n")
    off = kstr_emit2(out, off, "setp.eq.u32 %p2, %t1, 1;\n")
    off = kstr_emit2(out, off, "@%p2 bra HIGH;\n")
    off = kstr_emit2(out, off, "bra LUTL;\n")
    off = kstr_emit2(out, off, "HIGH:\n")
    off = kstr_emit2(out, off, "shr.u32 %nib, %e0, 4;\n")
    // f = lut[nib]
    off = kstr_emit2(out, off, "LUTL:\n")
    off = kstr_emit2(out, off, "mul.wide.u32 %addr2, %nib, 4;\n")
    off = kstr_emit2(out, off, "add.u64 %addr2, %rl, %addr2;\n")
    off = kstr_emit2(out, off, "ld.global.f32 %f, [%addr2];\n")
    // scale_idx = m*K32 + k/32 ; kk=kp[scale_idx]; f *= 2^kk
    off = kstr_emit2(out, off, "mul.lo.u32 %bi, %m, %K32;\n")
    off = kstr_emit2(out, off, "shr.u32 %t1, %k, 5;\n")
    off = kstr_emit2(out, off, "add.u32 %bi, %bi, %t1;\n")
    off = kstr_emit2(out, off, "mul.wide.u32 %addr2, %bi, 4;\n")
    off = kstr_emit2(out, off, "add.u64 %addr2, %rk, %addr2;\n")
    off = kstr_emit2(out, off, "ld.global.s32 %t2, [%addr2];\n")
    off = kstr_emit2(out, off, "cvt.rn.f32.s32 %fk, %t2;\n")
    off = kstr_emit2(out, off, "ex2.approx.f32 %fk, %fk;\n")
    off = kstr_emit2(out, off, "mul.f32 %f, %f, %fk;\n")
    // a = act[k]; acc = fma(a, f, acc)
    off = kstr_emit2(out, off, "mul.wide.u32 %addr2, %k, 4;\n")
    off = kstr_emit2(out, off, "add.u64 %addr2, %ra, %addr2;\n")
    off = kstr_emit2(out, off, "ld.global.f32 %a, [%addr2];\n")
    off = kstr_emit2(out, off, "fma.rn.f32 %acc, %a, %f, %acc;\n")
    off = kstr_emit2(out, off, "add.u32 %k, %k, 1;\n")
    off = kstr_emit2(out, off, "bra LOOP;\n")
    // out[m] = acc
    off = kstr_emit2(out, off, "DONE:\n")
    off = kstr_emit2(out, off, "mul.wide.u32 %addr2, %m, 4;\n")
    off = kstr_emit2(out, off, "add.u64 %addr2, %ro, %addr2;\n")
    off = kstr_emit2(out, off, "st.global.f32 [%addr2], %acc;\n")
    off = kstr_emit2(out, off, "EXIT:\n")
    off = kstr_emit2(out, off, "ret;\n")
    off = kstr_emit2(out, off, "}\n")
    gebe_zurueck off
Ende
