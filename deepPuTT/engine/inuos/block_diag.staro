// inuos/block.staro - DeepSeek-V4-Flash 完整 Block (mHC + attn + moe) 自研引擎库
// 依赖: sys str file safetensors quant fp8 bf16 softfloat math cuda
//       fp4_kernel fp8_kernel fp32_kernel mhc
// 镜像 modeling_deepseek_v4.py DeepseekV4Block.forward (moe0/attn0 已验证算子)
//
// 上下文 ctx 布局 (u64 指针, 由 block0_test.starc 填充):
//   0   data_start      8   wqa        16  wqas       24  wqb
//   32  wqbs            40  wkv        48  wkvs       56  woa
//   64  woas            72  wob        80  wobs       88  qn
//   96  kvn            104  sink       112 attn_norm_w 120 ffn_norm_w
//   128 hc_attn_fn     136 hc_attn_base 144 hc_attn_scale
//   152 hc_ffn_fn      160 hc_ffn_base  168 hc_ffn_scale
//   176 gatew          184 tid        192 eoff
//   200 shw1           208 shw1s      216 shw2        224 shw2s
//   232 shw3           240 shw3s      248 cossin
//   256 mod4           264 func4      272 mod8        280 func8
//   288 modb           296 funcb      304 gpu_lut4     312 gpu_lut8
//   320 mod32          328 func32

Funktion gemv_fp4(wbase, sbase, act, out, M, K, ncb32, gpu_lut, mod, func)
    nsc = M * ncb32
    gpu_w = cuda_mem_alloc(M * (K / 2))
    gpu_pow = cuda_mem_alloc(nsc * 4)
    gpu_act = cuda_mem_alloc(K * 4)
    gpu_out = cuda_mem_alloc(M * 4)
    powbuf = alloc(nsc * 4)
    g = 0
    Solange g < nsc
        raw_set32(powbuf, g * 4, fp32_mul_pow2(1065353216, e8m0_exp(raw_byteat(sbase, g))))
        g = g + 1
    Ende
    wbuf = alloc(M * (K / 2))
    i = 0
    Solange i < M * (K / 2)
        raw_setbyte(wbuf, i, raw_byteat(wbase, i))
        i = i + 1
    Ende
    cuda_memcpy_htod(gpu_w, wbuf, M * (K / 2))
    cuda_memcpy_htod(gpu_pow, powbuf, nsc * 4)
    cuda_memcpy_htod(gpu_act, act, K * 4)
    pw = alloc(8)
    raw_set64(pw, 0, gpu_w)
    pl = alloc(8)
    raw_set64(pl, 0, gpu_lut)
    pp = alloc(8)
    raw_set64(pp, 0, gpu_pow)
    pa = alloc(8)
    raw_set64(pa, 0, gpu_act)
    po = alloc(8)
    raw_set64(po, 0, gpu_out)
    pM = alloc(4)
    raw_set32(pM, 0, M)
    pK = alloc(4)
    raw_set32(pK, 0, K)
    pn = alloc(4)
    raw_set32(pn, 0, ncb32)
    params = alloc(64)
    raw_set64(params, 0, pw)
    raw_set64(params, 8, pl)
    raw_set64(params, 16, pp)
    raw_set64(params, 24, pa)
    raw_set64(params, 32, po)
    raw_set64(params, 40, pM)
    raw_set64(params, 48, pK)
    raw_set64(params, 56, pn)
    grid = (M + 255) / 256
    cuda_launch(func, grid, 1, 1, 256, 1, 1, 0, 0, params)
    cuda_memcpy_dtoh(out, gpu_out, M * 4)
    cuda_mem_free(gpu_w)
    cuda_mem_free(gpu_pow)
    cuda_mem_free(gpu_act)
    cuda_mem_free(gpu_out)
    gebe_zurueck 0
Ende

Funktion gemv_fp8(wbase, sbase, act, out, M, K, ncb, gpu_lut, mod, func)
    nsc = (M / 128) * (K / 128)
    gpu_w = cuda_mem_alloc(M * K)
    gpu_pow = cuda_mem_alloc(nsc * 4)
    gpu_act = cuda_mem_alloc(K * 4)
    gpu_out = cuda_mem_alloc(M * 4)
    powbuf = alloc(nsc * 4)
    g = 0
    Solange g < nsc
        raw_set32(powbuf, g * 4, fp32_mul_pow2(1065353216, e8m0_exp(raw_byteat(sbase, g))))
        g = g + 1
    Ende
    wbuf = alloc(M * K)
    i = 0
    Solange i < M * K
        raw_setbyte(wbuf, i, raw_byteat(wbase, i))
        i = i + 1
    Ende
    cuda_memcpy_htod(gpu_w, wbuf, M * K)
    cuda_memcpy_htod(gpu_pow, powbuf, nsc * 4)
    cuda_memcpy_htod(gpu_act, act, K * 4)
    pw = alloc(8)
    raw_set64(pw, 0, gpu_w)
    pl = alloc(8)
    raw_set64(pl, 0, gpu_lut)
    pp = alloc(8)
    raw_set64(pp, 0, gpu_pow)
    pa = alloc(8)
    raw_set64(pa, 0, gpu_act)
    po = alloc(8)
    raw_set64(po, 0, gpu_out)
    pM = alloc(4)
    raw_set32(pM, 0, M)
    pK = alloc(4)
    raw_set32(pK, 0, K)
    pn = alloc(4)
    raw_set32(pn, 0, ncb)
    params = alloc(64)
    raw_set64(params, 0, pw)
    raw_set64(params, 8, pl)
    raw_set64(params, 16, pp)
    raw_set64(params, 24, pa)
    raw_set64(params, 32, po)
    raw_set64(params, 40, pM)
    raw_set64(params, 48, pK)
    raw_set64(params, 56, pn)
    grid = (M + 255) / 256
    cuda_launch(func, grid, 1, 1, 256, 1, 1, 0, 0, params)
    cuda_memcpy_dtoh(out, gpu_out, M * 4)
    cuda_mem_free(gpu_w)
    cuda_mem_free(gpu_pow)
    cuda_mem_free(gpu_act)
    cuda_mem_free(gpu_out)
    gebe_zurueck 0
Ende

Funktion gemv_bf16(wbase, act, out, M, K, mod, func)
    gpu_w = cuda_mem_alloc(M * K * 2)
    gpu_act = cuda_mem_alloc(K * 4)
    gpu_out = cuda_mem_alloc(M * 4)
    Ausgeben "GB_w="
    Ausgeben gpu_w
    Ausgeben "GB_o="
    Ausgeben gpu_out
    wbuf = alloc(M * K * 2)
    i = 0
    Solange i < M * K * 2
        raw_setbyte(wbuf, i, raw_byteat(wbase, i))
        i = i + 1
    Ende
    cuda_memcpy_htod(gpu_w, wbuf, M * K * 2)
    cuda_memcpy_htod(gpu_act, act, K * 4)
    pw = alloc(8)
    raw_set64(pw, 0, gpu_w)
    pa = alloc(8)
    raw_set64(pa, 0, gpu_act)
    po = alloc(8)
    raw_set64(po, 0, gpu_out)
    pM = alloc(4)
    raw_set32(pM, 0, M)
    pK = alloc(4)
    raw_set32(pK, 0, K)
    params = alloc(40)
    raw_set64(params, 0, pw)
    raw_set64(params, 8, pa)
    raw_set64(params, 16, po)
    raw_set64(params, 24, pM)
    raw_set64(params, 32, pK)
    grid = (M + 255) / 256
    cuda_launch(func, grid, 1, 1, 256, 1, 1, 0, 0, params)
    cuda_memcpy_dtoh(out, gpu_out, M * 4)
    cuda_mem_free(gpu_w)
    cuda_mem_free(gpu_act)
    cuda_mem_free(gpu_out)
    gebe_zurueck 0
Ende

// RMSNorm 带 BF16 weight
Funktion rmsnorm_w(wb, x, n)
    acc = 0
    i = 0
    Solange i < n
        v = raw_get32(x, i * 4)
        acc = f32_add(acc, f32_mul(v, v))
        i = i + 1
    Ende
    r = f32_div(1065353216, f32_sqrt(f32_add(f32_div(acc, s32_to_f32(n)), 897988541)))
    i = 0
    Solange i < n
        v = raw_get32(x, i * 4)
        w = decode_bf16(wb, i * 2)
        raw_set32(x, i * 4, f32_mul(f32_mul(v, r), w))
        i = i + 1
    Ende
    gebe_zurueck 0
Ende

// 无权重逐头 RMSNorm (q_b_norm)
Funktion rmsnorm_u(x, roff, n)
    acc = 0
    i = 0
    Solange i < n
        v = raw_get32(x, (roff + i) * 4)
        acc = f32_add(acc, f32_mul(v, v))
        i = i + 1
    Ende
    r = f32_div(1065353216, f32_sqrt(f32_add(f32_div(acc, s32_to_f32(n)), 897988541)))
    i = 0
    Solange i < n
        v = raw_get32(x, (roff + i) * 4)
        raw_set32(x, (roff + i) * 4, f32_mul(v, r))
        i = i + 1
    Ende
    gebe_zurueck 0
Ende

// 部分 RoPE (后 64 维)
Funktion rope_apply(x, roff, cossin, pos)
    base = pos * 64
    i = 0
    Solange i < 32
        c = raw_get32(cossin, (base + i) * 4)
        s = raw_get32(cossin, (base + 32 + i) * 4)
        x0 = raw_get32(x, (roff + 2 * i) * 4)
        x1 = raw_get32(x, (roff + 2 * i + 1) * 4)
        raw_set32(x, (roff + 2 * i) * 4, f32_sub(f32_mul(x0, c), f32_mul(x1, s)))
        raw_set32(x, (roff + 2 * i + 1) * 4, f32_add(f32_mul(x0, s), f32_mul(x1, c)))
        i = i + 1
    Ende
    gebe_zurueck 0
Ende

Funktion rope_reverse(x, roff, cossin, pos)
    base = pos * 64
    i = 0
    Solange i < 32
        c = raw_get32(cossin, (base + i) * 4)
        s = raw_get32(cossin, (base + 32 + i) * 4)
        x0 = raw_get32(x, (roff + 2 * i) * 4)
        x1 = raw_get32(x, (roff + 2 * i + 1) * 4)
        raw_set32(x, (roff + 2 * i) * 4, f32_add(f32_mul(x0, c), f32_mul(x1, s)))
        raw_set32(x, (roff + 2 * i + 1) * 4, f32_sub(f32_mul(x1, c), f32_mul(x0, s)))
        i = i + 1
    Ende
    gebe_zurueck 0
Ende

// MLA 注意力 (单 token t 对 kv_cache[0..t], 滑动窗口)
Funktion attn_forward(x, kv_cache, t, ctx)
    wqa = raw_get64(ctx, 8)
    wqas = raw_get64(ctx, 16)
    wqb = raw_get64(ctx, 24)
    wqbs = raw_get64(ctx, 32)
    wkv = raw_get64(ctx, 40)
    wkvs = raw_get64(ctx, 48)
    woa = raw_get64(ctx, 56)
    woas = raw_get64(ctx, 64)
    wob = raw_get64(ctx, 72)
    wobs = raw_get64(ctx, 80)
    qn = raw_get64(ctx, 88)
    kvn = raw_get64(ctx, 96)
    sink = raw_get64(ctx, 104)
    cossin = raw_get64(ctx, 248)
    gpu_lut8 = raw_get64(ctx, 304)
    mod8 = raw_get64(ctx, 272)
    func8 = raw_get64(ctx, 280)

    qres = alloc(1024 * 4)
    qbuf = alloc(32768 * 4)
    kvbuf = alloc(512 * 4)
    attn_buf = alloc(32768 * 4)
    y = alloc(8192 * 4)
    out = alloc(4096 * 4)
    Ausgeben "AT_a0_t="
    Ausgeben t

    // q_residual = q_norm(wq_a @ x)
    gemv_fp8(wqa, wqas, x, qres, 1024, 4096, 32, gpu_lut8, mod8, func8)
    Ausgeben "AT_a1"
    rmsnorm_w(qn, qres, 1024)
    Ausgeben "AT_a2"
    // q = wq_b @ q_res
    gemv_fp8(wqb, wqbs, qres, qbuf, 32768, 1024, 8, gpu_lut8, mod8, func8)
    Ausgeben "AT_a3"
    hh = 0
    Solange hh < 64
        rmsnorm_u(qbuf, hh * 512, 512)
        rope_apply(qbuf, hh * 512 + 448, cossin, t)
        hh = hh + 1
    Ende
    Ausgeben "AT_a4"
    // kv = kv_norm(wkv @ x)
    gemv_fp8(wkv, wkvs, x, kvbuf, 512, 4096, 32, gpu_lut8, mod8, func8)
    Ausgeben "AT_a5"
    rmsnorm_w(kvn, kvbuf, 512)
    Ausgeben "AT_a6"
    rope_apply(kvbuf, 448, cossin, t)
    c = 0
    Solange c < 512
        raw_set32(kv_cache, (t * 512 + c) * 4, raw_get32(kvbuf, c * 4))
        c = c + 1
    Ende
    Ausgeben "AT_a7"
    // 每头注意力 + softmax_sink + 加权和
    z = alloc(4 * 4)
    e = alloc(4 * 4)
    scaling = f32_div(1065353216, f32_sqrt(1140850688))
    Ausgeben "AT_b0"
    hh = 0
    Solange hh < 64
        j = 0
        Solange j <= t
            acc = 0
            d = 0
            Solange d < 512
                acc = f32_add(acc, f32_mul(raw_get32(qbuf, (hh * 512 + d) * 4), raw_get32(kv_cache, (j * 512 + d) * 4)))
                d = d + 1
            Ende
            raw_set32(z, j * 4, f32_mul(scaling, acc))
            j = j + 1
        Ende
        zmax = raw_get32(z, 0)
        j = 1
        Solange j <= t
            zv = raw_get32(z, j * 4)
            Wenn zv > zmax dann
                zmax = zv
            Ende
            j = j + 1
        Ende
        sinkh = raw_get32(sink, hh * 4)
        Wenn sinkh > zmax dann
            zmax = sinkh
        Ende
        denom = 0
        j = 0
        Solange j <= t
            zv = raw_get32(z, j * 4)
            ev = f32_exp(f32_sub(zv, zmax))
            raw_set32(e, j * 4, ev)
            denom = f32_add(denom, ev)
            j = j + 1
        Ende
        esink = f32_exp(f32_sub(sinkh, zmax))
        denom = f32_add(denom, esink)
        d = 0
        Solange d < 512
            a = 0
            j = 0
            Solange j <= t
                a = f32_add(a, f32_mul(f32_div(raw_get32(e, j * 4), denom), raw_get32(kv_cache, (j * 512 + d) * 4)))
                j = j + 1
            Ende
            raw_set32(attn_buf, (hh * 512 + d) * 4, a)
            d = d + 1
        Ende
        rope_reverse(attn_buf, hh * 512 + 448, cossin, t)
        hh = hh + 1
    Ende
    Ausgeben "AT_b1"
    // 分组 wo_a -> [8192] -> wo_b -> [4096]
    g = 0
    Solange g < 8
        gemv_fp8(woa + g * 4194304, woas + g * 256, attn_buf + g * 4096 * 4, y + g * 1024 * 4, 1024, 4096, 32, gpu_lut8, mod8, func8)
        g = g + 1
    Ende
    gemv_fp8(wob, wobs, y, out, 4096, 8192, 64, gpu_lut8, mod8, func8)
    // 复制 out -> x
    d = 0
    Solange d < 4096
        raw_set32(x, d * 4, raw_get32(out, d * 4))
        d = d + 1
    Ende
    gebe_zurueck 0
Ende

// MoE (单 token, hash 路由 + 6 专家 FP4 + shared FP8)
Funktion moe_forward(x, token, ctx)
    gatew = raw_get64(ctx, 176)
    tid = raw_get64(ctx, 184)
    eoff = raw_get64(ctx, 192)
    data_start = raw_get64(ctx, 0)
    shw1 = raw_get64(ctx, 200)
    shw1s = raw_get64(ctx, 208)
    shw2 = raw_get64(ctx, 216)
    shw2s = raw_get64(ctx, 224)
    shw3 = raw_get64(ctx, 232)
    shw3s = raw_get64(ctx, 240)
    mod4 = raw_get64(ctx, 256)
    func4 = raw_get64(ctx, 264)
    mod8 = raw_get64(ctx, 272)
    func8 = raw_get64(ctx, 280)
    modb = raw_get64(ctx, 288)
    funcb = raw_get64(ctx, 296)
    gpu_lut4 = raw_get64(ctx, 304)
    gpu_lut8 = raw_get64(ctx, 312)

    HID = 4096
    MID = 2048
    TOPK = 6
    LIMIT = 1092616192
    NEGLIM = 3240099840
    ROUTE = 1069547520
    EPS = 841731191

    scores = alloc(256 * 4)
    Ausgeben "MO_a0_tok="
    Ausgeben token
    gemv_bf16(gatew, x, scores, 256, HID, modb, funcb)
    Ausgeben "MO_a1"
    e = 0
    Solange e < 256
        sv = raw_get32(scores, e * 4)
        sq = f32_sqrtsoftplus(sv)
        raw_set32(scores, e * 4, sq)
        e = e + 1
    Ende
    chosen = alloc(6 * 4)
    wts = alloc(6 * 4)
    sum = 0
    i = 0
    Solange i < 6
        eid = raw_get64(tid, (token * 6 + i) * 8)
        raw_set32(chosen, i * 4, eid)
        sc = raw_get32(scores, eid * 4)
        raw_set32(wts, i * 4, sc)
        sum = f32_add(sum, sc)
        i = i + 1
    Ende
    denom = f32_add(sum, EPS)
    i = 0
    Solange i < 6
        w = raw_get32(wts, i * 4)
        w = f32_mul(f32_div(w, denom), ROUTE)
        raw_set32(wts, i * 4, w)
        i = i + 1
    Ende
    y = alloc(HID * 4)
    d = 0
    Solange d < HID
        raw_set32(y, d * 4, 0)
        d = d + 1
    Ende
    i = 0
    Solange i < 6
        eid = raw_get32(chosen, i * 4)
        Ausgeben "MO_exp_i="
        Ausgeben i
        wo1 = data_start + raw_get64(eoff, (eid * 6 + 0) * 8)
        wo2 = data_start + raw_get64(eoff, (eid * 6 + 1) * 8)
        wo3 = data_start + raw_get64(eoff, (eid * 6 + 2) * 8)
        so1 = data_start + raw_get64(eoff, (eid * 6 + 3) * 8)
        so2 = data_start + raw_get64(eoff, (eid * 6 + 4) * 8)
        so3 = data_start + raw_get64(eoff, (eid * 6 + 5) * 8)
        gate = alloc(MID * 4)
        up = alloc(MID * 4)
        gemv_fp4(wo1, so1, x, gate, MID, HID, 128, gpu_lut4, mod4, func4)
        Ausgeben "MO_exp1"
        gemv_fp4(wo3, so3, x, up, MID, HID, 128, gpu_lut4, mod4, func4)
        Ausgeben "MO_exp2"
        d = 0
        Solange d < MID
            g = raw_get32(gate, d * 4)
            u = raw_get32(up, d * 4)
            Wenn fs_sign(g) == 0 dann
                Wenn g > LIMIT dann
                    g = LIMIT
                Ende
            Ende
            Wenn fs_sign(u) == 0 dann
                Wenn u > LIMIT dann
                    u = LIMIT
                Ende
            Sonst
                Wenn u > NEGLIM dann
                    u = NEGLIM
                Ende
            Ende
            raw_set32(gate, d * 4, f32_mul(f32_silu(g), u))
            d = d + 1
        Ende
        eo = alloc(HID * 4)
        gemv_fp4(wo2, so2, gate, eo, HID, MID, 64, gpu_lut4, mod4, func4)
        Ausgeben "MO_exp3"
        wi = raw_get32(wts, i * 4)
        d = 0
        Solange d < HID
            raw_set32(y, d * 4, f32_add(raw_get32(y, d * 4), f32_mul(wi, raw_get32(eo, d * 4))))
            d = d + 1
        Ende
        i = i + 1
    Ende
    sgate = alloc(MID * 4)
    sup = alloc(MID * 4)
    gemv_fp8(shw1, shw1s, x, sgate, MID, HID, 32, gpu_lut8, mod8, func8)
    gemv_fp8(shw3, shw3s, x, sup, MID, HID, 32, gpu_lut8, mod8, func8)
    d = 0
    Solange d < MID
        g = raw_get32(sgate, d * 4)
        u = raw_get32(sup, d * 4)
        Wenn fs_sign(g) == 0 dann
            Wenn g > LIMIT dann
                g = LIMIT
            Ende
        Ende
        Wenn fs_sign(u) == 0 dann
            Wenn u > LIMIT dann
                u = LIMIT
            Ende
        Sonst
            Wenn u > NEGLIM dann
                u = NEGLIM
            Ende
        Ende
        raw_set32(sgate, d * 4, f32_mul(f32_silu(g), u))
        d = d + 1
    Ende
    shout = alloc(HID * 4)
    gemv_fp8(shw2, shw2s, sgate, shout, HID, MID, 16, gpu_lut8, mod8, func8)
    d = 0
    Solange d < HID
        raw_set32(y, d * 4, f32_add(raw_get32(y, d * 4), raw_get32(shout, d * 4)))
        d = d + 1
    Ende
    d = 0
    Solange d < HID
        raw_set32(x, d * 4, raw_get32(y, d * 4))
        d = d + 1
    Ende
    gebe_zurueck 0
Ende

// 完整 Block: hidden[4,4096] 进 -> hidden[4,4096] 出 (原地)
Funktion block_forward(ctx, hidden, kv_cache, t, token)
    hc_attn_fn = raw_get64(ctx, 128)
    hc_attn_base = raw_get64(ctx, 136)
    hc_attn_scale = raw_get64(ctx, 144)
    hc_ffn_fn = raw_get64(ctx, 152)
    hc_ffn_base = raw_get64(ctx, 160)
    hc_ffn_scale = raw_get64(ctx, 168)
    attn_norm_w = raw_get64(ctx, 112)
    ffn_norm_w = raw_get64(ctx, 120)
    mod32 = raw_get64(ctx, 320)
    func32 = raw_get64(ctx, 328)

    prew = alloc(4 * 4)
    postw = alloc(4 * 4)
    comb = alloc(16 * 4)
    x = alloc(4096 * 4)
    prew2 = alloc(4 * 4)
    postw2 = alloc(4 * 4)
    comb2 = alloc(16 * 4)
    hidden_mid = alloc(4 * 4096 * 4)

    // ---- Attention 半 ----
    Ausgeben "BF_a1"
    mhc_pre(hidden, hc_attn_fn, hc_attn_base, hc_attn_scale, prew, postw, comb, x, 0, mod32, func32)
    Ausgeben "BF_a2"
    rmsnorm_w(attn_norm_w, x, 4096)
    Ausgeben "BF_a3"
    attn_forward(x, kv_cache, t, ctx)
    Ausgeben "BF_a4"
    mhc_post(x, hidden, postw, comb, hidden_mid)
    Ausgeben "BF_a5"
    // ---- FFN/MoE 半 ----
    Ausgeben "BF_f1"
    mhc_pre(hidden_mid, hc_ffn_fn, hc_ffn_base, hc_ffn_scale, prew2, postw2, comb2, x, 0, mod32, func32)
    Ausgeben "BF_f1b"
    rmsnorm_w(ffn_norm_w, x, 4096)
    Ausgeben "BF_f2"
    moe_forward(x, token, ctx)
    Ausgeben "BF_f3"
    mhc_post(x, hidden_mid, postw2, comb2, hidden)
    Ausgeben "BF_f4"
    gebe_zurueck 0
Ende
