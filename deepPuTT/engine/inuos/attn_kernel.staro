// inuos/attn_kernel.staro - GPU MLA 注意力内核 PTX 生成 (deepPuTT)
// 依赖: sys.staro, str.staro (str_len)
//
// 3 个内核替换 StarC CPU 的 O(t) 注意力循环 (64头 x t token, 每 token O(t) 成本):
//   attn_dot:     s[hh][j] = scale * dot(q[hh], kv[j])   (q: 64x512, kv: n x 512)
//   attn_softmax: 每头软最大/软max/归一, 含 sink (attn_bias)
//   attn_out:     out[hh][d] = sum_j w[hh][j] * kv[j][d]
// 参数: hh=64 头, d=512 维, n=当前 token 数 (t+1)

Funktion kstr_emit3(out, off, s)
    n = str_len(s)
    i = 0
    Solange i < n
        raw_setbyte(out, off + i, raw_byteat(s, 8 + i))
        i = i + 1
    Ende
    gebe_zurueck off + n
Ende

// attn_dot(q, kv, s, n, hh, scale): 每线程算 s[hh*n+j]
Funktion attn_dot_ptx(out, off)
    off = kstr_emit3(out, off, ".version 7.0\n")
    off = kstr_emit3(out, off, ".target sm_75\n")
    off = kstr_emit3(out, off, ".address_size 64\n")
    off = kstr_emit3(out, off, ".visible .entry attn_dot(.param .u64 q, .param .u64 kv, .param .u64 s, .param .u32 n, .param .u32 hh, .param .f32 scale, .param .u32 ring) {\n")
    off = kstr_emit3(out, off, ".reg .u32 %e, %n, %hh, %d, %t1, %t2, %hhv, %jv, %idx, %ring;\n")
    off = kstr_emit3(out, off, ".reg .u64 %rq, %rk, %rs, %a, %a2;\n")
    off = kstr_emit3(out, off, ".reg .f32 %fq, %fk, %acc, %sc, %res;\n")
    off = kstr_emit3(out, off, ".reg .pred %p;\n")
    // e = blockIdx*blockDim + threadIdx
    off = kstr_emit3(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit3(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %e, %t1, %t2;\n")
    off = kstr_emit3(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit3(out, off, "add.u32 %e, %e, %t1;\n")
    off = kstr_emit3(out, off, "ld.param.u32 %hh, [hh];\n")
    off = kstr_emit3(out, off, "ld.param.u32 %n, [n];\n")
    off = kstr_emit3(out, off, "ld.param.u32 %ring, [ring];\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %t1, %hh, %n;\n")
    off = kstr_emit3(out, off, "setp.ge.u32 %p, %e, %t1;\n")
    off = kstr_emit3(out, off, "@%p bra EXIT;\n")
    // hhv = e/n ; jv = e%n
    off = kstr_emit3(out, off, "div.u32 %hhv, %e, %n;\n")
    off = kstr_emit3(out, off, "rem.u32 %jv, %e, %n;\n")
    off = kstr_emit3(out, off, "ld.param.u64 %rq, [q];\n")
    off = kstr_emit3(out, off, "ld.param.u64 %rk, [kv];\n")
    off = kstr_emit3(out, off, "mov.f32 %acc, 0f00000000;\n")
    off = kstr_emit3(out, off, "mov.u32 %d, 0;\n")
    // 循环 d<512: acc += q[hhv*512+d] * kv[jv*512+d]
    off = kstr_emit3(out, off, "LOOPD:\n")
    off = kstr_emit3(out, off, "setp.ge.u32 %p, %d, 512;\n")
    off = kstr_emit3(out, off, "@%p bra DONE;\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %t1, %hhv, 512;\n")
    off = kstr_emit3(out, off, "add.u32 %t1, %t1, %d;\n")
    off = kstr_emit3(out, off, "mul.wide.u32 %a, %t1, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a, %rq, %a;\n")
    off = kstr_emit3(out, off, "ld.global.f32 %fq, [%a];\n")
    off = kstr_emit3(out, off, "add.u32 %t2, %ring, %jv;\n")
    off = kstr_emit3(out, off, "and.b32 %t2, %t2, 127;\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %t2, %t2, 512;\n")
    off = kstr_emit3(out, off, "add.u32 %t2, %t2, %d;\n")
    off = kstr_emit3(out, off, "mul.wide.u32 %a2, %t2, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a2, %rk, %a2;\n")
    off = kstr_emit3(out, off, "ld.global.f32 %fk, [%a2];\n")
    off = kstr_emit3(out, off, "fma.rn.f32 %acc, %fq, %fk, %acc;\n")
    off = kstr_emit3(out, off, "add.u32 %d, %d, 1;\n")
    off = kstr_emit3(out, off, "bra LOOPD;\n")
    off = kstr_emit3(out, off, "DONE:\n")
    off = kstr_emit3(out, off, "ld.param.f32 %sc, [scale];\n")
    off = kstr_emit3(out, off, "mul.f32 %res, %acc, %sc;\n")
    // s[e] = res
    off = kstr_emit3(out, off, "ld.param.u64 %rs, [s];\n")
    off = kstr_emit3(out, off, "mul.wide.u32 %a, %e, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a, %rs, %a;\n")
    off = kstr_emit3(out, off, "st.global.f32 [%a], %res;\n")
    off = kstr_emit3(out, off, "EXIT:\n")
    off = kstr_emit3(out, off, "ret;\n")
    off = kstr_emit3(out, off, "}\n")
    gebe_zurueck off
Ende

// attn_softmax(s, sink, w, n, hh): 每头一个 block, 串行 j, 含 sink 归一
Funktion attn_softmax_ptx(out, off)
    off = kstr_emit3(out, off, ".version 7.0\n")
    off = kstr_emit3(out, off, ".target sm_75\n")
    off = kstr_emit3(out, off, ".address_size 64\n")
    off = kstr_emit3(out, off, ".visible .entry attn_softmax(.param .u64 s, .param .u64 sink, .param .u64 w, .param .u32 n, .param .u32 hh) {\n")
    off = kstr_emit3(out, off, ".reg .u32 %hhv, %n, %j, %t1, %t2;\n")
    off = kstr_emit3(out, off, ".reg .u64 %rs, %rsk, %rw, %a;\n")
    off = kstr_emit3(out, off, ".reg .f32 %zmax, %sv, %ev, %den, %sinkv, %inv;\n")
    off = kstr_emit3(out, off, ".reg .pred %p;\n")
    off = kstr_emit3(out, off, "mov.u32 %hhv, %ctaid.x;\n")
    off = kstr_emit3(out, off, "ld.param.u32 %n, [n];\n")
    off = kstr_emit3(out, off, "ld.param.u64 %rs, [s];\n")
    off = kstr_emit3(out, off, "ld.param.u64 %rsk, [sink];\n")
    off = kstr_emit3(out, off, "ld.param.u64 %rw, [w];\n")
    // zmax = sink[hhv]
    off = kstr_emit3(out, off, "mul.wide.u32 %a, %hhv, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a, %rsk, %a;\n")
    off = kstr_emit3(out, off, "ld.global.f32 %zmax, [%a];\n")
    // for j: zmax = max(zmax, s[hhv*n+j])
    off = kstr_emit3(out, off, "mov.u32 %j, 0;\n")
    off = kstr_emit3(out, off, "LOOPMAX:\n")
    off = kstr_emit3(out, off, "setp.ge.u32 %p, %j, %n;\n")
    off = kstr_emit3(out, off, "@%p bra MAXDONE;\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %t1, %hhv, %n;\n")
    off = kstr_emit3(out, off, "add.u32 %t1, %t1, %j;\n")
    off = kstr_emit3(out, off, "mul.wide.u32 %a, %t1, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a, %rs, %a;\n")
    off = kstr_emit3(out, off, "ld.global.f32 %sv, [%a];\n")
    off = kstr_emit3(out, off, "setp.gt.f32 %p, %sv, %zmax;\n")
    off = kstr_emit3(out, off, "@%p mov.f32 %zmax, %sv;\n")
    off = kstr_emit3(out, off, "add.u32 %j, %j, 1;\n")
    off = kstr_emit3(out, off, "bra LOOPMAX;\n")
    off = kstr_emit3(out, off, "MAXDONE:\n")
    // denom = 0; for j: ev = exp(s-zmax); w=ev; denom+=ev
    off = kstr_emit3(out, off, "mov.f32 %den, 0f00000000;\n")
    off = kstr_emit3(out, off, "mov.u32 %j, 0;\n")
    off = kstr_emit3(out, off, "LOOPE:\n")
    off = kstr_emit3(out, off, "setp.ge.u32 %p, %j, %n;\n")
    off = kstr_emit3(out, off, "@%p bra EDONE;\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %t1, %hhv, %n;\n")
    off = kstr_emit3(out, off, "add.u32 %t1, %t1, %j;\n")
    off = kstr_emit3(out, off, "mul.wide.u32 %a, %t1, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a, %rs, %a;\n")
    off = kstr_emit3(out, off, "ld.global.f32 %sv, [%a];\n")
    // ev = exp(sv - zmax) = ex2((sv-zmax)*log2e)
    off = kstr_emit3(out, off, "sub.f32 %ev, %sv, %zmax;\n")
    off = kstr_emit3(out, off, "mul.f32 %ev, %ev, 0f3fb8aa3b;\n")
    off = kstr_emit3(out, off, "ex2.approx.f32 %ev, %ev;\n")
    off = kstr_emit3(out, off, "add.f32 %den, %den, %ev;\n")
    // w[hhv*n+j] = ev
    off = kstr_emit3(out, off, "mul.wide.u32 %a, %t1, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a, %rw, %a;\n")
    off = kstr_emit3(out, off, "st.global.f32 [%a], %ev;\n")
    off = kstr_emit3(out, off, "add.u32 %j, %j, 1;\n")
    off = kstr_emit3(out, off, "bra LOOPE;\n")
    off = kstr_emit3(out, off, "EDONE:\n")
    // denom += exp(sink-zmax)
    off = kstr_emit3(out, off, "mul.wide.u32 %a, %hhv, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a, %rsk, %a;\n")
    off = kstr_emit3(out, off, "ld.global.f32 %sinkv, [%a];\n")
    off = kstr_emit3(out, off, "sub.f32 %ev, %sinkv, %zmax;\n")
    off = kstr_emit3(out, off, "mul.f32 %ev, %ev, 0f3fb8aa3b;\n")
    off = kstr_emit3(out, off, "ex2.approx.f32 %ev, %ev;\n")
    off = kstr_emit3(out, off, "add.f32 %den, %den, %ev;\n")
    // inv = 1/den ; for j: w /= den
    off = kstr_emit3(out, off, "div.rn.f32 %inv, 0f3f800000, %den;\n")
    off = kstr_emit3(out, off, "mov.u32 %j, 0;\n")
    off = kstr_emit3(out, off, "LOOPDIV:\n")
    off = kstr_emit3(out, off, "setp.ge.u32 %p, %j, %n;\n")
    off = kstr_emit3(out, off, "@%p bra DIVDONE;\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %t1, %hhv, %n;\n")
    off = kstr_emit3(out, off, "add.u32 %t1, %t1, %j;\n")
    off = kstr_emit3(out, off, "mul.wide.u32 %a, %t1, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a, %rw, %a;\n")
    off = kstr_emit3(out, off, "ld.global.f32 %ev, [%a];\n")
    off = kstr_emit3(out, off, "mul.f32 %ev, %ev, %inv;\n")
    off = kstr_emit3(out, off, "st.global.f32 [%a], %ev;\n")
    off = kstr_emit3(out, off, "add.u32 %j, %j, 1;\n")
    off = kstr_emit3(out, off, "bra LOOPDIV;\n")
    off = kstr_emit3(out, off, "DIVDONE:\n")
    off = kstr_emit3(out, off, "ret;\n")
    off = kstr_emit3(out, off, "}\n")
    gebe_zurueck off
Ende

// attn_out(w, kv, out, n, hh): 每线程算 out[hh*512+d]
Funktion attn_out_ptx(out, off)
    off = kstr_emit3(out, off, ".version 7.0\n")
    off = kstr_emit3(out, off, ".target sm_75\n")
    off = kstr_emit3(out, off, ".address_size 64\n")
    off = kstr_emit3(out, off, ".visible .entry attn_out(.param .u64 w, .param .u64 kv, .param .u64 out, .param .u32 n, .param .u32 hh, .param .u32 ring) {\n")
    off = kstr_emit3(out, off, ".reg .u32 %e, %n, %hh, %hhv, %dv, %j, %t1, %t2, %ring;\n")
    off = kstr_emit3(out, off, ".reg .u64 %rw, %rk, %ro, %a, %a2;\n")
    off = kstr_emit3(out, off, ".reg .f32 %wv, %kv, %acc;\n")
    off = kstr_emit3(out, off, ".reg .pred %p;\n")
    off = kstr_emit3(out, off, "mov.u32 %t1, %ctaid.x;\n")
    off = kstr_emit3(out, off, "mov.u32 %t2, %ntid.x;\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %e, %t1, %t2;\n")
    off = kstr_emit3(out, off, "mov.u32 %t1, %tid.x;\n")
    off = kstr_emit3(out, off, "add.u32 %e, %e, %t1;\n")
    off = kstr_emit3(out, off, "ld.param.u32 %hh, [hh];\n")
    off = kstr_emit3(out, off, "ld.param.u32 %n, [n];\n")
    off = kstr_emit3(out, off, "ld.param.u32 %ring, [ring];\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %t1, %hh, 512;\n")
    off = kstr_emit3(out, off, "setp.ge.u32 %p, %e, %t1;\n")
    off = kstr_emit3(out, off, "@%p bra EXIT;\n")
    off = kstr_emit3(out, off, "div.u32 %hhv, %e, 512;\n")
    off = kstr_emit3(out, off, "rem.u32 %dv, %e, 512;\n")
    off = kstr_emit3(out, off, "ld.param.u64 %rw, [w];\n")
    off = kstr_emit3(out, off, "ld.param.u64 %rk, [kv];\n")
    off = kstr_emit3(out, off, "mov.f32 %acc, 0f00000000;\n")
    off = kstr_emit3(out, off, "mov.u32 %j, 0;\n")
    // for j<n: acc += w[hhv*n+j] * kv[j*512+dv]
    off = kstr_emit3(out, off, "LOOPJ:\n")
    off = kstr_emit3(out, off, "setp.ge.u32 %p, %j, %n;\n")
    off = kstr_emit3(out, off, "@%p bra JDONE;\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %t1, %hhv, %n;\n")
    off = kstr_emit3(out, off, "add.u32 %t1, %t1, %j;\n")
    off = kstr_emit3(out, off, "mul.wide.u32 %a, %t1, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a, %rw, %a;\n")
    off = kstr_emit3(out, off, "ld.global.f32 %wv, [%a];\n")
    off = kstr_emit3(out, off, "add.u32 %t2, %ring, %j;\n")
    off = kstr_emit3(out, off, "and.b32 %t2, %t2, 127;\n")
    off = kstr_emit3(out, off, "mul.lo.u32 %t2, %t2, 512;\n")
    off = kstr_emit3(out, off, "add.u32 %t2, %t2, %dv;\n")
    off = kstr_emit3(out, off, "mul.wide.u32 %a2, %t2, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a2, %rk, %a2;\n")
    off = kstr_emit3(out, off, "ld.global.f32 %kv, [%a2];\n")
    off = kstr_emit3(out, off, "fma.rn.f32 %acc, %wv, %kv, %acc;\n")
    off = kstr_emit3(out, off, "add.u32 %j, %j, 1;\n")
    off = kstr_emit3(out, off, "bra LOOPJ;\n")
    off = kstr_emit3(out, off, "JDONE:\n")
    off = kstr_emit3(out, off, "ld.param.u64 %ro, [out];\n")
    off = kstr_emit3(out, off, "mul.wide.u32 %a, %e, 4;\n")
    off = kstr_emit3(out, off, "add.u64 %a, %ro, %a;\n")
    off = kstr_emit3(out, off, "st.global.f32 [%a], %acc;\n")
    off = kstr_emit3(out, off, "EXIT:\n")
    off = kstr_emit3(out, off, "ret;\n")
    off = kstr_emit3(out, off, "}\n")
    gebe_zurueck off
Ende
