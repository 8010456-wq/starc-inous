Funktion h2_put(buf, pos, s)
    i = 0
    Solange raw_byteat(s, 8 + i) != 0
        raw_setbyte(buf, pos + i, raw_byteat(s, 8 + i))
        i = i + 1
    Ende
    gebe_zurueck pos + i
Ende

Funktion h2_nl(buf, pos)
    raw_setbyte(buf, pos, 13)
    raw_setbyte(buf, pos + 1, 10)
    gebe_zurueck pos + 2
Ende

Funktion gen_file(rules, outpath)
    cnt = qrb_count(rules)
    rs = u32_get(rules, 12)
    cap = cnt * 64 + 512
    buf = alloc(cap)
    p = 0
    p = h2_put(buf, p, "# === XIN BLOCK START (auto-generated by Xin, do not edit) ===")
    p = h2_nl(buf, p)
    i = 0
    Solange i < cnt
        roff = 16 + i * rs
        rl = raw_byteat(rules, roff)
        p = h2_put(buf, p, "0.0.0.0 ")
        j = 0
        Solange j < rl
            raw_setbyte(buf, p, raw_byteat(rules, roff + 1 + j))
            p = p + 1
            j = j + 1
        Ende
        p = h2_nl(buf, p)
        i = i + 1
    Ende
    p = h2_put(buf, p, "# === XIN BLOCK END ===")
    p = h2_nl(buf, p)
    h = x_open_w(outpath)
    Wenn h <= 0 dann gebe_zurueck 0 - 1 Ende
    x_write_buf(h, buf, p)
    x_close(h)
    gebe_zurueck p
Ende
